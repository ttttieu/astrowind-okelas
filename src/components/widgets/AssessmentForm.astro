---
/**
 * Interactive Assessment Form Component
 * Renders full ERP Readiness Assessment (13 questions)
 * Collects answers, submits to API, displays results with optional contact form
 */

interface Props {
  assessmentId: string;
  language: 'vi' | 'en';
}

const { assessmentId, language } = Astro.props;
---

<div class="assessment-container max-w-4xl mx-auto px-4 py-12">
  <div id="assessment-form" class="space-y-8">
    <!-- Loading state (hidden by default, shown by JS) -->
    <div id="loading-state" class="hidden text-center py-12">
      <div class="inline-flex items-center gap-3">
        <div class="animate-spin rounded-full h-6 w-6 border-2 border-primary border-t-transparent"></div>
        <span class="text-gray-600">
          {language === 'vi' ? 'Đang tải câu hỏi...' : 'Loading questions...'}
        </span>
      </div>
    </div>

    <!-- Questions container -->
    <div id="questions-container" class="space-y-8">
      <!-- Questions will be rendered here by JavaScript -->
    </div>

    <!-- Results container (hidden until submission) -->
    <div id="results-container" class="hidden space-y-8">
      <!-- Results will be rendered here -->
    </div>
  </div>
</div>

<script define:vars={{ assessmentId, language }}>
  class AssessmentForm {
    constructor(assessmentId, language) {
      this.assessmentId = assessmentId;
      this.language = language;
      this.questions = [];
      this.answers = {};
      this.startTime = Date.now();
      this.respondentInfo = {
        org_name: null,
        role: null,
        contact: null
      };
      this.resultData = null;
      this.init();
    }

    async init() {
      try {
        console.log(`[Assessment] Loading ${this.assessmentId} in ${this.language}`);
        await this.fetchQuestions();
        console.log(`[Assessment] Loaded ${this.questions.length} questions`);
        this.renderQuestions();
      } catch (error) {
        console.error('[Assessment] Failed to load:', error);
        this.showError(
          this.language === 'vi'
            ? `Lỗi khi tải assessment: ${error instanceof Error ? error.message : String(error)}`
            : `Failed to load assessment: ${error instanceof Error ? error.message : String(error)}`
        );
      }
    }

    async fetchQuestions() {
      const lang = this.language === 'en' ? 'en' : 'vi';
      const url = `/api/assessment/${this.assessmentId}/questions?language=${lang}`;
      console.log(`[Assessment] Fetching from: ${url}`);
      const response = await fetch(url);
      if (!response.ok) {
        const errorText = await response.text();
        throw new Error('HTTP ' + response.status + ': ' + errorText);
      }
      const data = await response.json();
      this.questions = data.questions || [];
      this.intro = data.intro;
      this.title = data.title;
    }

    renderQuestions() {
      const container = document.getElementById('questions-container');
      if (!container) return;

      container.innerHTML = '';

      // Add intro section
      const introDiv = document.createElement('div');
      introDiv.className = 'bg-blue-50 border-l-4 border-blue-500 p-6 rounded';
      introDiv.innerHTML = `
        <h2 class="text-xl font-semibold text-gray-900 mb-3">${this.title}</h2>
        <p class="text-gray-700">${this.intro}</p>
        <p class="text-sm text-gray-600 mt-3">
          ${this.language === 'vi'
            ? '⏱️ Khoảng 6 phút | ' + this.questions.length + ' câu hỏi | Không có câu trả lời đúng hay sai'
            : '⏱️ About 6 minutes | ' + this.questions.length + ' questions | No right or wrong answers'}
        </p>
      `;
      container.appendChild(introDiv);

      // Add guidance about "I'm not sure" option
      const guidanceDiv = document.createElement('div');
      guidanceDiv.className = 'bg-amber-50 border-l-4 border-amber-500 p-6 rounded mb-8';
      guidanceDiv.innerHTML = `
        <p class="text-amber-900 text-sm">
          <strong>💡 ${this.language === 'vi' ? 'Lưu ý:' : 'Note:'}</strong>
          ${this.language === 'vi'
            ? ' Nếu bạn chọn "Tôi chưa nắm rõ" cho bất kỳ câu hỏi nào, đó cũng là một phản hồi hợp lệ và quan trọng. Nó giúp xác định các lĩnh vực cần khám phá thêm.'
            : ' If you select "I\'m not sure" for any question, that\'s also a valid and important response. It helps identify areas that need further exploration.'}
        </p>
      `;
      container.appendChild(guidanceDiv);

      // Render each question
      this.questions.forEach((question, idx) => {
        const questionDiv = this.createQuestionElement(question, idx);
        container.appendChild(questionDiv);
      });

      // Add submit button
      const submitBtn = document.createElement('button');
      submitBtn.id = 'submit-btn';
      submitBtn.className = 'w-full mt-8 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition';
      submitBtn.textContent = this.language === 'vi' ? 'Xem kết quả' : 'View Results';
      submitBtn.addEventListener('click', () => this.handleSubmit());
      container.appendChild(submitBtn);

      // Digitalization: hide Q11 when Q0 selects H (no software)
      if (this.assessmentId === 'digitalization_level') {
        const q11El = document.getElementById('question-Q11-SYSTEM-USAGE');
        const updateQ11Visibility = () => {
          const hChecked = document.querySelector('input[name="ms-Q0-SYSTEMS"][value="H"]:checked');
          if (q11El) q11El.style.display = hChecked ? 'none' : '';
        };
        document.querySelectorAll('input[name="ms-Q0-SYSTEMS"]').forEach(cb => {
          cb.addEventListener('change', updateQ11Visibility);
        });
      }
    }

    explainFlag(flag) {
      const explanations = {
        'F1': {
          vi: 'Quy trình kinh doanh chưa được chuẩn hoá - cần tiêu chuẩn hoá trước khi triển khai ERP',
          en: 'Business processes are not yet standardized - process standardization should precede ERP implementation'
        },
        'F2': {
          vi: 'Dữ liệu nền (danh mục, master data) chưa đạt tiêu chuẩn - cần dọn dẹp và quản lý chặt chẽ',
          en: 'Master data foundation is weak - data cleanup and governance must be addressed first'
        },
        'F3': {
          vi: 'Phạm vi triển khai và mục tiêu chưa rõ ràng - cần xác định cụ thể thành công nghĩa là gì',
          en: 'Project scope and success criteria are unclear - must be clearly defined before implementation'
        },
        'F4': {
          vi: 'Cam kết của lãnh đạo chưa đủ mạnh - ERP cần sự hỗ trợ rõ ràng từ Ban lãnh đạo',
          en: 'Leadership commitment is insufficient - ERP implementation requires strong executive sponsorship'
        },
        'F5': {
          vi: 'Tổ chức chưa sẵn sàng cho thay đổi - cần xây dựng kế hoạch quản lý thay đổi chi tiết',
          en: 'Organization is not ready for change - a detailed change management plan is essential'
        },
        'straight_lining_low': {
          vi: 'Các câu trả lời có mô tả hành vi hoặc cách hiểu chưa nhất quán - hãy xem xét lại các câu hỏi',
          en: 'Your answers show patterns that may need review - consider revisiting your responses for consistency'
        }
      };

      return explanations[flag]?.[this.language] || flag;
    }

    createQuestionElement(question, index) {
      const questionDiv = document.createElement('div');
      questionDiv.className = 'border border-gray-200 dark:border-gray-700 rounded-lg p-6 bg-white dark:bg-gray-800 shadow-sm';
      questionDiv.id = `question-${question.id}`;

      let innerHTML = `
        <div class="flex items-start gap-2 mb-4">
          <span class="text-sm font-semibold text-blue-600 bg-blue-100 px-3 py-1 rounded-full">Q${index + 1}</span>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 flex-1">${question.text}</h3>
        </div>
      `;

      if (question.type === 'open_text') {
        innerHTML += `
          <textarea
            id="answer-${question.id}"
            class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white text-gray-900 placeholder-gray-400 dark:bg-gray-800 dark:text-gray-100 dark:border-gray-600 dark:placeholder-gray-500"
            rows="4"
            placeholder="${this.language === 'vi' ? 'Nhập suy nghĩ của bạn...' : 'Share your thoughts...'}"
          ></textarea>
        `;
      } else if (question.type === 'multi_select') {
        // Checkbox question — supports exclusive option (key H = no software)
        innerHTML += `<p class="text-sm text-gray-500 mb-3">${this.language === 'vi' ? 'Chọn tất cả đang áp dụng' : 'Select all that apply'}</p><div class="space-y-3" id="ms-${question.id}">`;
        question.options?.forEach((option) => {
          const uniqueId = `ms-${question.id}-${option.key}`;
          innerHTML += `
            <label class="flex items-start gap-3 p-3 border border-gray-200 dark:border-gray-600 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition" id="mslabel-${question.id}-${option.key}">
              <input
                type="checkbox"
                name="ms-${question.id}"
                value="${option.key}"
                id="${uniqueId}"
                class="mt-1 w-4 h-4 text-blue-600 cursor-pointer"
                ${option.exclusive ? 'data-exclusive="true"' : ''}
              />
              <div class="flex-1">
                <span class="font-medium text-gray-900 dark:text-gray-100">${option.text}</span>
              </div>
            </label>
          `;
        });
        innerHTML += '</div>';

        setTimeout(() => {
          const container = document.getElementById(`ms-${question.id}`);
          if (!container) return;
          container.querySelectorAll('input[type="checkbox"]').forEach((cb) => {
            cb.addEventListener('change', () => {
              if (cb.dataset.exclusive && cb.checked) {
                // Exclusive: uncheck all others
                container.querySelectorAll('input[type="checkbox"]').forEach(other => {
                  if (other !== cb) other.checked = false;
                });
              } else if (cb.checked) {
                // Non-exclusive checked: uncheck any exclusive option
                container.querySelectorAll('input[data-exclusive]').forEach(excl => {
                  excl.checked = false;
                });
              }
            });
          });
        }, 0);
      } else if (question.type === 'matrix') {
        // Matrix question — rows × columns grid
        const cols = question.options || [];
        innerHTML += `<div class="overflow-x-auto"><table class="w-full text-sm border-collapse">`;
        innerHTML += `<thead><tr><th class="text-left p-2 text-gray-600 font-medium w-1/3"></th>`;
        cols.forEach(col => {
          innerHTML += `<th class="p-2 text-center text-gray-600 font-medium text-xs">${col.text}</th>`;
        });
        innerHTML += `</tr></thead><tbody>`;
        (question.rows || []).forEach((row, ri) => {
          const rowBg = ri % 2 === 0 ? 'bg-gray-50 dark:bg-gray-700/30' : 'bg-white dark:bg-transparent';
          innerHTML += `<tr class="${rowBg}"><td class="p-2 font-medium text-gray-800 dark:text-gray-200 text-sm">${row.label || row.text}</td>`;
          cols.forEach(col => {
            const uid = `matrix-${question.id}-${row.key}-${col.key}`;
            innerHTML += `
              <td class="p-2 text-center">
                <input
                  type="radio"
                  name="matrix-${question.id}-${row.key}"
                  value="${col.key}"
                  id="${uid}"
                  class="w-4 h-4 text-blue-600 cursor-pointer"
                />
              </td>`;
          });
          innerHTML += `</tr>`;
        });
        innerHTML += `</tbody></table></div>`;
      } else if (question.type === 'single_select' || question.type === 'context' || !question.type) {
        innerHTML += '<div class="space-y-3">';
        question.options?.forEach((option) => {
          const uniqueId = `${question.id}-${option.key}`;
          innerHTML += `
            <label class="flex items-start gap-3 p-3 border border-gray-200 dark:border-gray-600 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700 transition">
              <input
                type="radio"
                name="question-${question.id}"
                value="${option.key}"
                id="${uniqueId}"
                class="mt-1 w-4 h-4 text-blue-600 cursor-pointer"
              />
              <div class="flex-1">
                <span class="font-medium text-gray-900 dark:text-gray-100">${option.text}</span>
              </div>
            </label>
          `;
        });
        innerHTML += '</div>';

        setTimeout(() => {
          document.querySelectorAll(`input[name="question-${question.id}"]`).forEach((input) => {
            input.addEventListener('change', (e) => {
              this.answers[question.id] = e.target.value;
            });
          });
        }, 0);
      }

      questionDiv.innerHTML = innerHTML;
      return questionDiv;
    }

    async handleSubmit() {
      // Validate required questions
      // multi_select (Q0) = context, not required
      // matrix (Q1) = required: all rows must have a selection
      // single_select/context (original context type) = required only if not context type
      const unanswered = [];
      for (const q of this.questions) {
        if (q.type === 'open_text' || q.type === 'multi_select') continue;
        if (q.type === 'context' || q.id.includes('context')) continue;
        if (q.type === 'matrix') {
          // Check all rows answered
          const rows = q.rows || [];
          const unansweredRows = rows.filter(row =>
            !document.querySelector(`input[name="matrix-${q.id}-${row.key}"]:checked`)
          );
          if (unansweredRows.length > 0) unanswered.push(q);
        } else {
          // single_select
          if (!document.querySelector(`input[name="question-${q.id}"]:checked`)) {
            unanswered.push(q);
          }
        }
      }

      if (unanswered.length > 0) {
        alert(this.language === 'vi'
          ? 'Vui lòng trả lời tất cả câu hỏi'
          : 'Please answer all questions');
        return;
      }

      // Show loading state
      document.getElementById('questions-container').classList.add('hidden');
      document.getElementById('loading-state').classList.remove('hidden');

      try {
        const elapsedSeconds = (Date.now() - this.startTime) / 1000;

        // Collect answers from DOM
        const answers = this.questions.map(q => {
          if (q.type === 'open_text') {
            const textarea = document.getElementById(`answer-${q.id}`);
            return { question_id: q.id, selected_key: null, open_text: textarea?.value || null };
          }
          if (q.type === 'multi_select') {
            const checked = Array.from(document.querySelectorAll(`input[name="ms-${q.id}"]:checked`))
              .map(el => el.value);
            return { question_id: q.id, selected_keys: checked };
          }
          if (q.type === 'matrix') {
            const area_answers = {};
            (q.rows || []).forEach(row => {
              const sel = document.querySelector(`input[name="matrix-${q.id}-${row.key}"]:checked`);
              if (sel) area_answers[row.key] = sel.value;
            });
            return { question_id: q.id, area_answers };
          }
          // single_select / context
          const checked = document.querySelector(`input[name="question-${q.id}"]:checked`);
          return { question_id: q.id, selected_key: checked?.value || null };
        });

        const submission = {
          assessment_id: this.assessmentId,
          respondent: this.respondentInfo,
          answers: answers,
          submitted_at: new Date().toISOString(),
          elapsed_seconds: elapsedSeconds,
          honeypot: '' // Anti-spam
        };

        // Submit to backend with language parameter
        const lang = this.language === 'en' ? 'en' : 'vi';
        const response = await fetch(`/api/assessment/submit?language=${lang}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(submission)
        });

        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }

        const result = await response.json();
        this.displayResults(result);

      } catch (error) {
        console.error('Submission error:', error);
        this.showError(this.language === 'vi'
          ? 'Lỗi khi gửi assessment'
          : 'Error submitting assessment');
        document.getElementById('loading-state').classList.add('hidden');
        document.getElementById('questions-container').classList.remove('hidden');
      }
    }

    displayResults(result) {
      document.getElementById('loading-state').classList.add('hidden');
      document.getElementById('questions-container').classList.add('hidden');

      const container = document.getElementById('results-container');
      container.classList.remove('hidden');

      const hasLevel = result.level !== null && result.level !== undefined;

      let html = `
        <div class="bg-gradient-to-r ${hasLevel ? 'from-blue-50 to-indigo-50 border-blue-200' : 'from-amber-50 to-orange-50 border-amber-200'} rounded-lg p-8 border">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">
            ${this.language === 'vi' ? 'Kết quả đánh giá của bạn' : 'Your Assessment Results'}
          </h2>
          <p class="text-gray-700 mb-6">
            ${result.description || result.insufficient_data_message || (this.language === 'vi' ? 'Đánh giá đã hoàn thành' : 'Assessment complete')}
          </p>

          <div class="mb-8">
            <div class="inline-block px-6 py-2 ${hasLevel ? 'bg-blue-600' : 'bg-amber-600'} text-white font-bold rounded-full text-lg">
              ${hasLevel ? (result.label || 'Level ' + result.level) : (this.language === 'vi' ? 'Cần Khám Phá Thêm' : 'Needs Exploration')}
            </div>
          </div>

          ${result.archetype_label ? `
            <div class="mt-4 p-4 bg-white bg-opacity-60 rounded-lg border border-blue-100">
              <p class="text-sm font-semibold text-gray-800 mb-1">
                ${this.language === 'vi' ? 'Hồ sơ doanh nghiệp:' : 'Business Profile:'} ${result.archetype_label}
              </p>
              <p class="text-sm text-gray-600">${result.archetype_description || ''}</p>
            </div>
          ` : ''}

          ${result.actual_level ? `
            <div class="mt-4 p-4 bg-amber-50 rounded-lg border border-amber-200">
              <p class="text-sm text-amber-900">
                <strong>${this.language === 'vi' ? '⚠️ Cấp vận hành thực tế:' : '⚠️ Actual operational level:'}</strong>
                ${this.language === 'vi'
                  ? ' Doanh nghiệp đã trả tiền cho cấp ' + result.level + ', nhưng đang vận hành ở cấp ' + result.actual_level + ' — ' + (result.actual_level_label || '') + '.'
                  : ' Your organization has paid for Level ' + result.level + ' but is operating at Level ' + result.actual_level + ' — ' + (result.actual_level_label || '') + '.'}
              </p>
            </div>
          ` : ''}

          ${result.software_gap_message ? `
            <div class="mt-4 p-4 bg-purple-50 rounded-lg border border-purple-200">
              <p class="text-sm text-purple-900">${result.software_gap_message}</p>
            </div>
          ` : ''}
        </div>

        ${result.area_map ? `
          <div class="bg-white rounded-lg p-8 border border-gray-200 mt-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-2">
              ${this.language === 'vi' ? 'Bản đồ số hóa theo mảng' : 'Digitalization Map by Area'}
            </h3>
            <p class="text-sm text-gray-500 mb-6">
              ${this.language === 'vi'
                ? 'A = Giấy · B = File rải rác · C = Qua phần mềm · D = Tích hợp'
                : 'A = Paper · B = Scattered files · C = Through software · D = Integrated'}
            </p>
            <div class="grid grid-cols-5 gap-3">
              ${Object.entries(result.area_map).map(([key, area]) => {
                const levelColors = ['bg-red-100 border-red-300 text-red-800', 'bg-orange-100 border-orange-300 text-orange-800', 'bg-yellow-100 border-yellow-300 text-yellow-800', 'bg-green-100 border-green-300 text-green-800'];
                const col = area.level ? levelColors[area.level - 1] : 'bg-gray-100 border-gray-300 text-gray-500';
                const levelLabel = ['A','B','C','D'][area.level - 1] || '?';
                const isWeakest = result.weakest_area?.key === key;
                return `
                  <div class="flex flex-col items-center p-3 rounded-lg border-2 ${col} ${isWeakest ? 'ring-2 ring-blue-500 ring-offset-1' : ''}">
                    <span class="text-2xl font-bold">${levelLabel}</span>
                    <span class="text-xs font-medium text-center mt-1 leading-tight">${area.name}</span>
                    ${isWeakest ? '<span class="text-xs mt-1 text-blue-700 font-semibold">▼ ' + (this.language === 'vi' ? 'Yếu nhất' : 'Weakest') + '</span>' : ''}
                  </div>`;
              }).join('')}
            </div>
            ${result.next_step ? `
              <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                <p class="text-sm font-semibold text-blue-900 mb-1">
                  ${this.language === 'vi'
                    ? '→ Bước tiếp theo cho mảng ' + (result.weakest_area?.name || '') + ':'
                    : '→ Next step for ' + (result.weakest_area?.name || '') + ':'}
                </p>
                <p class="text-sm text-blue-800">${result.next_step}</p>
              </div>
            ` : ''}
          </div>
        ` : ''}

        ${result.dimension_scores && Object.keys(result.dimension_scores).length > 0 ? `
          <div class="bg-white rounded-lg p-8 border border-gray-200 mt-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-6">
              ${this.assessmentId === 'digitalization_level'
                ? (this.language === 'vi' ? 'Đánh giá theo 5 thành phần' : 'Assessment by 5 Dimensions')
                : (this.language === 'vi' ? 'Đánh giá theo 6 thành phần' : 'Assessment by 6 Dimensions')}
            </h3>
            <div class="space-y-5">
              ${Object.entries(result.dimension_scores).map(([key, dim]) => {
                const levelColors = ['bg-red-500', 'bg-orange-400', 'bg-yellow-400', 'bg-green-500'];
                const levelColor = dim.level ? levelColors[dim.level - 1] : 'bg-gray-300';
                const barWidth = dim.score !== null ? Math.round((dim.score / 3) * 100) : 0;
                return `
                <div>
                  <div class="flex justify-between items-start mb-1">
                    <span class="text-sm font-medium text-gray-800">${dim.name || key}</span>
                    <span class="text-xs font-semibold px-2 py-0.5 rounded-full ml-2 whitespace-nowrap
                      ${dim.level === 4 ? 'bg-green-100 text-green-800' :
                        dim.level === 3 ? 'bg-yellow-100 text-yellow-800' :
                        dim.level === 2 ? 'bg-orange-100 text-orange-800' :
                        dim.level === 1 ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-600'}">
                      ${dim.label || '—'}
                    </span>
                  </div>
                  <div class="w-full bg-gray-200 rounded-full h-2">
                    <div class="${levelColor} h-2 rounded-full transition-all" style="width: ${barWidth}%"></div>
                  </div>
                </div>`;
              }).join('')}
            </div>
          </div>
        ` : ''}

        ${result.recommendations && result.recommendations.length > 0 ? `
          <div class="bg-green-50 rounded-lg p-6 border border-green-200 mt-8">
            <h3 class="text-lg font-semibold text-green-900 mb-3">
              ${this.language === 'vi' ? '3 việc nên làm trong 90 ngày tới' : '3 Actions for the Next 90 Days'}
            </h3>
            <ol class="space-y-3">
              ${result.recommendations.map((rec, i) => `
                <li class="text-sm text-green-900 flex gap-2">
                  <span class="font-bold shrink-0">${i + 1}.</span>
                  <span>${rec}</span>
                </li>
              `).join('')}
            </ol>
          </div>
        ` : ''}

        ${result.flags && result.flags.length > 0 ? `
          <div class="bg-amber-50 rounded-lg p-6 border border-amber-200 mt-8">
            <h3 class="text-lg font-semibold text-amber-900 mb-3">
              ${this.language === 'vi' ? 'Điểm nghẽn cần xử lý trước' : 'Critical Blockers to Address First'}
            </h3>
            <ul class="space-y-3">
              ${result.flags.map(flag => `
                <li class="text-sm text-amber-900">
                  <span class="font-semibold">${flag.label || flag.code}:</span>
                  <span class="ml-1">${flag.explanation || ''}</span>
                </li>
              `).join('')}
            </ul>
          </div>
        ` : ''}

        <div class="bg-blue-50 dark:bg-slate-800 rounded-lg p-8 border border-blue-200 dark:border-blue-700 mt-8">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2">
            ${this.language === 'vi' ? 'Đặt lịch đánh giá thực địa' : 'Schedule an On-Site Assessment'}
          </h3>
          <p class="text-gray-700 dark:text-gray-300 mb-4">
            ${this.language === 'vi'
              ? 'Báo cáo này phản ánh góc nhìn của anh/chị. Bước tiếp theo: đánh giá chi tiết cùng OKELAS — trưởng các phòng ban trả lời bộ câu hỏi riêng, anh/chị nhận bản đồ lệch nhận thức và lộ trình chuẩn bị theo thứ tự ưu tiên.'
              : 'This report reflects your perspective. Next step: a detailed on-site assessment with OKELAS — department heads answer their own question set, and you receive a perception-gap map with a prioritized preparation roadmap.'}
          </p>
          <p class="text-sm text-blue-700 dark:text-blue-300 bg-blue-100 dark:bg-blue-900/40 rounded-lg px-4 py-2 mb-6">
            ${this.language === 'vi'
              ? 'Tất cả thông tin bên dưới đều là tùy chọn. Chỉ điền nếu anh/chị muốn OKELAS team liên hệ để sắp xếp một buổi khảo sát thực địa, lên báo cáo chi tiết và lộ trình 90 ngày cho doanh nghiệp.'
              : 'All fields below are optional. Fill in only if you want the OKELAS team to reach out and arrange a detailed on-site assessment, full report, and 90-day roadmap for your organization.'}
          </p>

          <div class="space-y-4">
            <input
              type="text"
              id="org_name"
              placeholder="${this.language === 'vi' ? 'Tên công ty' : 'Company name'}"
              class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
            <input
              type="text"
              id="role"
              placeholder="${this.language === 'vi' ? 'Vị trí / chức vụ' : 'Your role / position'}"
              class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
            <input
              type="text"
              id="fullname"
              placeholder="${this.language === 'vi' ? 'Họ và tên' : 'Full name'}"
              class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
            <input
              type="tel"
              id="contact"
              placeholder="${this.language === 'vi' ? 'Số điện thoại' : 'Phone number'}"
              class="w-full p-3 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            />
            <button
              id="contact-submit-btn"
              class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition"
            >
              ${this.language === 'vi' ? 'Đặt lịch tư vấn' : 'Book a Consultation'}
            </button>
          </div>
        </div>
      `;

      this.resultData = result;
      container.innerHTML = html;

      // Add event listener for contact form submission
      document.getElementById('contact-submit-btn').addEventListener('click', () => {
        this.handleContactSubmit(result.submission_id);
      });
    }

    async handleContactSubmit(submissionId) {
      const orgName = document.getElementById('org_name').value;
      const role = document.getElementById('role').value;
      const fullname = document.getElementById('fullname').value;
      const contact = document.getElementById('contact').value;

      // UTM params from landing URL
      const utmParams = new URLSearchParams(window.location.search);

      try {
        const response = await fetch('/api/assessment/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            submission_id: submissionId,
            assessment_id: this.assessmentId,
            org_name: orgName,
            role: role,
            fullname: fullname,
            contact: contact,
            submitted_at: new Date().toISOString(),
            language: this.language,
            // Assessment result context for Telegram alert
            assessment_level: this.resultData?.level ?? null,
            assessment_label: this.resultData?.label ?? null,
            assessment_archetype: this.resultData?.archetype ?? null,
            assessment_archetype_label: this.resultData?.archetype_label ?? null,
            assessment_critical_flags: this.resultData?.critical_flags ?? [],
            assessment_gap_label: this.resultData?.gap_label ?? null,
            assessment_readiness_index: this.resultData?.readiness_index ?? null,
            // UTM tracking
            utm_source: utmParams.get('utm_source') || null,
            utm_medium: utmParams.get('utm_medium') || null,
            utm_campaign: utmParams.get('utm_campaign') || null,
          })
        });

        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }

        const msg = this.language === 'vi'
          ? 'Cảm ơn! Đội OKELAS sẽ liên hệ trong 1 ngày làm việc để xác nhận lịch.'
          : 'Thank you! The OKELAS team will contact you within 1 business day to confirm the schedule.';
        alert(msg);

        // Disable button and show success state
        document.getElementById('contact-submit-btn').disabled = true;
        document.getElementById('contact-submit-btn').textContent =
          this.language === 'vi' ? '✓ Đã gửi' : '✓ Sent';

      } catch (error) {
        console.error('Contact submission error:', error);
        alert(this.language === 'vi'
          ? 'Lỗi khi gửi thông tin'
          : 'Error sending information');
      }
    }

    showError(message) {
      const container = document.getElementById('questions-container');
      container.innerHTML = '<div class="bg-red-50 border border-red-200 rounded-lg p-6"><h3 class="text-red-900 font-semibold mb-2">Error</h3><p class="text-red-700">' + message + '</p></div>';
    }
  }

  // Initialize assessment form when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new AssessmentForm(assessmentId, language);
    });
  } else {
    new AssessmentForm(assessmentId, language);
  }
</script>

<style>
  .assessment-container {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
</style>
