---
interface Props {
  articleSlug: string;
  cluster: string;
  lang?: 'en' | 'vi';
}
const { articleSlug, cluster, lang = 'vi' } = Astro.props;
const isEN = lang === 'en';
---

<div
  class="mt-5 pt-4 border-t border-slate-200 dark:border-slate-700"
  data-vote-widget
  data-slug={articleSlug}
  data-cluster={cluster}
  data-lang={lang}
>
  <p class="text-sm font-medium text-slate-600 dark:text-slate-400 mb-3">
    {isEN ? 'Does this sound familiar to your organization?' : 'Điều này có đúng với doanh nghiệp bạn?'}
  </p>

  <div data-vote-buttons class="flex items-center gap-3">
    <button
      data-vote="yes"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm font-medium hover:bg-green-50 hover:border-green-300 hover:text-green-700 dark:hover:bg-green-900/20 dark:hover:border-green-700 dark:hover:text-green-400 transition-colors cursor-pointer"
    >
      <span aria-hidden="true">👍</span>
      {isEN ? 'Yes, this is us' : 'Đúng, đây là chúng tôi'}
    </button>
    <button
      data-vote="no"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors cursor-pointer"
    >
      <span aria-hidden="true">👎</span>
      {isEN ? 'Not quite' : 'Chưa hẳn'}
    </button>
  </div>

  <div data-vote-done class="hidden">
    <p data-vote-thanks class="text-sm font-medium text-green-700 dark:text-green-400"></p>
    <p data-vote-count class="text-sm text-slate-500 dark:text-slate-400 mt-1"></p>
  </div>
</div>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  async function fetchClusterYesCount(cluster: string): Promise<number | null> {
    if (!SUPABASE_URL || !SUPABASE_KEY) return null;
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/article_votes?cluster=eq.${encodeURIComponent(cluster)}&vote=eq.yes`,
        {
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            Prefer: 'count=exact',
            Range: '0-0',
          },
        }
      );
      const range = res.headers.get('Content-Range');
      if (!range) return null;
      const total = range.split('/')[1];
      return total ? parseInt(total, 10) : null;
    } catch {
      return null;
    }
  }

  async function submitVote(slug: string, cluster: string, vote: string): Promise<void> {
    if (!SUPABASE_URL || !SUPABASE_KEY) return;
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/article_votes`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
          'Content-Type': 'application/json',
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({ article_slug: slug, cluster, vote }),
      });
    } catch {
      // silent — vote is preserved in localStorage
    }
  }

  function showDoneState(widget: HTMLElement, vote: string, cluster: string) {
    const isEN = widget.dataset.lang === 'en';
    const buttonsEl = widget.querySelector<HTMLElement>('[data-vote-buttons]')!;
    const doneEl = widget.querySelector<HTMLElement>('[data-vote-done]')!;
    const thanksEl = widget.querySelector<HTMLElement>('[data-vote-thanks]')!;
    const countEl = widget.querySelector<HTMLElement>('[data-vote-count]')!;

    buttonsEl.classList.add('hidden');
    doneEl.classList.remove('hidden');

    thanksEl.textContent =
      vote === 'yes'
        ? isEN
          ? '✓ Thanks — you\'re not alone.'
          : '✓ Cảm ơn — bạn không đơn độc.'
        : isEN
          ? '✓ Thanks for the feedback.'
          : '✓ Cảm ơn phản hồi của bạn.';

    fetchClusterYesCount(cluster).then((count) => {
      if (count !== null && count > 0) {
        countEl.textContent = isEN
          ? `${count} organization${count === 1 ? '' : 's'} in the same category confirmed this.`
          : `${count} doanh nghiệp trong cùng chủ đề đã xác nhận điều này.`;
      }
    });
  }

  function initVote(widget: HTMLElement) {
    const slug = widget.dataset.slug!;
    const cluster = widget.dataset.cluster!;
    const storageKey = `vote_${slug}`;
    const existing = localStorage.getItem(storageKey);

    if (existing) {
      showDoneState(widget, existing, cluster);
      return;
    }

    widget.querySelectorAll<HTMLButtonElement>('[data-vote]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const vote = btn.dataset.vote!;
        localStorage.setItem(storageKey, vote);
        await submitVote(slug, cluster, vote);
        showDoneState(widget, vote, cluster);
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-vote-widget]').forEach(initVote);
  });
</script>
