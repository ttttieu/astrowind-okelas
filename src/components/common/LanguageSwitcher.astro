---
import { Icon } from 'astro-icon/components';
import { I18N } from 'astrowind:config';
import articlesMapping from '~/data/articles-mapping.json';

export interface Props {
  label?: string;
  class?: string;
  iconClass?: string;
  translationId?: string;
  lang?: 'en' | 'vi';
}

const {
  label = 'Toggle between Vietnamese and English',
  class:
    className = 'text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center',
  iconClass = 'w-5 h-5 lg:w-5 lg:h-5',
  translationId,
  lang,
} = Astro.props;

// Detect current language from URL path or config
const currentPath = Astro.url.pathname;
const currentLanguage = lang || (currentPath.startsWith('/en') ? 'en' : 'vi');
const isVietnamese = currentLanguage === 'vi';

// Build translation mapping for client-side script
const translationMap: Record<string, Record<string, string>> = {};
for (const article of articlesMapping.articles) {
  translationMap[article.translationId] = {
    vi: article.vi.url,
    en: article.en.url,
  };
}
---

<aw-language-switcher>
  <button
    type="button"
    class={className}
    aria-label={label}
    data-aw-toggle-language
    data-current-lang={currentLanguage}
    data-translation-id={translationId}
    data-translation-map={JSON.stringify(translationMap)}
  >
    <span class:list={['relative block', iconClass]}>
      <Icon
        name="tabler:world"
        class="absolute inset-0 h-full w-full transition-[opacity,transform] duration-200 motion-reduce:transition-none"
      />
    </span>
    <span class="ml-2 hidden lg:inline text-sm font-medium">
      {isVietnamese ? 'EN' : 'VI'}
    </span>
  </button>
</aw-language-switcher>

<style>
  aw-language-switcher {
    display: contents;
  }
</style>

<script>
  class AwLanguageSwitcher extends HTMLElement {
    private updateButtonState() {
      const button = this.querySelector('[data-aw-toggle-language]') as HTMLButtonElement;
      if (!button) return;

      const currentPath = window.location.pathname;
      const currentLang = currentPath.startsWith('/en') ? 'en' : 'vi';
      const isVietnamese = currentLang === 'vi';
      const textSpan = button.querySelector('span.ml-2');

      if (textSpan) {
        textSpan.textContent = isVietnamese ? 'EN' : 'VI';
      }
    }

    connectedCallback() {
      const button = this.querySelector('[data-aw-toggle-language]') as HTMLButtonElement;

      // Update button state on page load
      this.updateButtonState();
      document.addEventListener('astro:page-load', () => this.updateButtonState());

      button?.addEventListener('click', () => {
        // Detect current language from URL path
        const currentPath = window.location.pathname;
        const currentLang = currentPath.startsWith('/en') ? 'en' : 'vi';
        const newLang = currentLang === 'vi' ? 'en' : 'vi';

        localStorage.language = newLang;

        // Check if this is a translated article from data attributes
        let translationId = button.dataset.translationId || document.documentElement.dataset.translationId;
        let translationMapStr = button.dataset.translationMap;

        if (translationId && translationMapStr) {
          try {
            const translationMap = JSON.parse(translationMapStr);
            if (translationMap[translationId]) {
              const targetUrl = translationMap[translationId][newLang];
              if (targetUrl) {
                window.location.href = targetUrl;
                return;
              }
            }
          } catch (e) {
            console.error('Failed to parse translation map:', e);
          }
        }

        // Fallback: Toggle /en prefix for non-article pages
        let newPath = currentPath;

        // Remove existing /en/ prefix if present
        if (currentPath.startsWith('/en/')) {
          newPath = currentPath.replace(/^\/en/, '');
        } else if (currentPath === '/en') {
          newPath = '/';
        }

        // Add /en/ prefix if switching to English (and not at root)
        if (newLang === 'en') {
          if (newPath === '/') {
            newPath = '/en/';
          } else if (!newPath.startsWith('/en')) {
            newPath = `/en${newPath}`;
          }
        }

        // Navigate to the new path
        window.location.href = newPath || '/';
      });
    }
  }

  if (!customElements.get('aw-language-switcher')) {
    customElements.define('aw-language-switcher', AwLanguageSwitcher);
  }
</script>
