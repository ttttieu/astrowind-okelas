---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import { getArticlesByCategory } from '~/lib/insights';
import type { ImageMetadata } from 'astro';

const metadata = {
  title: 'Knowledge Management — OKELAS Insights',
  description:
    'Làm sao đưa tri thức ra khỏi đầu một vài người, biến nó thành thứ tổ chức có thể tra cứu, sử dụng lại và giao cho hệ thống AI.',
};

const { grouped } = await getArticlesByCategory('vi');
let kmArticles = grouped['knowledge-management'] || [];

// Import all VI KM cover images from src/assets (flat directory)
const viCoverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/insights/*-00-og-cover-vi.png',
  { eager: true }
);
const viCovers: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(viCoverGlob)) {
  const match = path.match(/\/([a-z]+)-00-og-cover-vi\.png$/);
  if (match) viCovers[match[1]] = mod.default;
}

// Map VI article ID → cover image prefix
const articleCoverPrefix: Record<string, string> = {
  'quan-ly-tri-thuc-doanh-nghiep-san-xuat': 'kmp',
  'tacit-knowledge-explicit-knowledge': 'tek',
  'excel-email-he-thong-van-hanh-ngam': 'xsi',
  'chi-phi-mat-tri-thuc-san-xuat': 'ckl',
  'dms-va-knowledge-management': 'dkm',
  'knowledge-graph-doanh-nghiep': 'kgb',
  'chuan-bi-audit-iso-mat-nhieu-thoi-gian': 'aud',
};

// Define article order: pillar first, then 3.1 to 3.9
const articleOrder: Record<string, number> = {
  'quan-ly-tri-thuc-doanh-nghiep-san-xuat': 0, // PILLAR
  'nhan-su-nghi-viec-mang-di-tri-thuc': 1, // 3.1
  'sop-khong-duoc-thuc-thi': 2, // 3.2
  'ai-tao-qua-nhieu-tai-lieu': 3, // 3.3
  'tacit-knowledge-explicit-knowledge': 4, // 3.4
  'excel-email-he-thong-van-hanh-ngam': 5, // 3.5
  'chi-phi-mat-tri-thuc-san-xuat': 6, // 3.6
  'dms-va-knowledge-management': 7, // 3.7
  'knowledge-graph-doanh-nghiep': 8, // 3.8
  'chuan-bi-audit-iso-mat-nhieu-thoi-gian': 9, // 3.9
};

// Sort articles by order
kmArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Knowledge Management" />

  <Content
    content={`
      <p>Khi một nhân sự nhiều kinh nghiệm nghỉ việc, thứ doanh nghiệp mất không chỉ là một vị trí cần tuyển lại. Đó là hàng loạt phán đoán, cách xử lý tình huống, quyết định nhỏ mà người đó tích lũy qua năm tháng — và chưa bao giờ được ghi lại ở đâu cả. Chuyên mục này bàn về việc làm sao đưa tri thức đó ra khỏi đầu một vài người, biến nó thành thứ tổ chức có thể tra cứu, sử dụng lại và giao cho cả hệ thống AI khai thác — mà không đánh mất phần giá trị cốt lõi trong đó.</p>

      <p class="mt-6">
        <strong>Bắt đầu từ đây — Bài viết Pillar:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/knowledge-management/quan-ly-tri-thuc-doanh-nghiep-san-xuat" class="text-primary hover:underline">Từ tri thức cá nhân đến tri thức tổ chức — bài toán mà doanh nghiệp sản xuất không thể né →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Góc nhìn của OKELAS:</strong>
        <a href="/why/tri-thuc-la-ha-tang" class="text-primary hover:underline ml-1">Tri thức là hạ tầng — vì sao chúng tôi không xem tri thức như một tủ hồ sơ →</a>
      </p>

      <p class="mt-3">
        <strong>Tự đánh giá:</strong>
        <a href="/readiness/knowledge-management" class="text-primary hover:underline ml-1">Làm bài Knowledge Readiness Assessment →</a>
      </p>

      <div class="mt-8">
        <p class="font-semibold mb-3">Các chủ đề đang được khai thác <span class="font-normal text-muted">(sẽ tiếp tục cập nhật):</span></p>
        <ul class="space-y-2 text-muted">
          <li>Tri thức tổ chức — khi định nghĩa được cụ thể hóa thay vì chỉ là khái niệm chung chung</li>
          <li>Từ tri thức ngầm sang tri thức tường minh — bước chuyển mà phần lớn doanh nghiệp bỏ qua</li>
          <li>Chia sẻ tri thức — vì sao "để lên thư mục chung" không giải quyết được vấn đề</li>
          <li>Giữ chân tri thức — chi phí thực sự khi một nhân sự chủ chốt ra đi</li>
          <li>Hạ tầng tri thức — xây để tái sử dụng, không chỉ để lưu trữ</li>
          <li>Quản lý tri thức và AI — một hệ thống AI cần gì từ tri thức của doanh nghiệp để thực sự hữu ích</li>
        </ul>
      </div>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Tất cả bài viết về Knowledge Management</h2>
      <ul class="space-y-6">
        {kmArticles.map((article) => {
          const prefix = articleCoverPrefix[article.id];
          const coverImg = prefix ? viCovers[prefix] : undefined;
          return (
          <li key={article.id} class="flex items-start gap-6 group">
            {coverImg && (
              <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                <Image
                  src={coverImg}
                  alt={article.data.title}
                  class="w-full h-auto block"
                />
              </div>
            )}
            <a
              href={`/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                {article.data.contentType && (
                  <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                    {article.data.contentType}
                  </span>
                )}
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Knowledge Readiness Assessment',
        href: '/readiness/knowledge-management',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Knowledge & Copilot',
        href: '/solutions/knowledge-copilot',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Doanh nghiệp phụ thuộc vào những người cụ thể đến mức nào?</Fragment>
    <Fragment slot="subtitle">
      Bài Knowledge Readiness Assessment giúp xác định tri thức nằm ở đâu — và điều gì sẽ xảy ra nếu những người giữ nó rời đi.
    </Fragment>
  </CallToAction>
</Layout>
