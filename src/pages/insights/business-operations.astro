---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'Business & Operations — OKELAS Insights',
  description:
    'Digitalization, process standardization, workflow and the operational habits that determine whether any system actually works once in place.',
};

const { grouped } = await getArticlesByCategory('vi');
let bizOpsArticles = grouped['business-operations'] || [];

// Define article order: 1 pillar + 9 articles (4.1 to 4.9)
const articleOrder: Record<string, number> = {
  'chuyen-doi-so-doanh-nghiep-san-xuat': 0, // PILLAR 1
  'giai-doan-so-hoa-doanh-nghiep': 1, // 4.1
  'paperless-khong-phai-chuyen-doi-so': 2, // 4.2
  'nhieu-phan-mem-chua-so-hoa': 3, // 4.3
  'lo-trinh-dms-eqms-knowledge-os': 4, // 4.4
  'so-hoa-ho-so-iso-gmp': 5, // 4.5
  'progressive-eqms-la-gi': 6, // 4.6
  'chi-phi-khong-so-hoa': 7, // 4.7
  'du-an-chuyen-doi-so-that-bai': 8, // 4.8
  'buoc-tiep-theo-so-hoa-co-nghia-kinh-te': 9, // 4.9
};

// Sort articles by order
bizOpsArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Business & Operations" />

  <Content
    content={`
      <p>Hiếm khi vấn đề vận hành tự gọi tên là "cần chuyển đổi số". Nó xuất hiện dưới dạng khác: một giám sát viên phải sửa cùng một lỗi lần thứ ba trong tháng, hoặc một quy trình từng chạy tốt ở quy mô 50 người nay bắt đầu rạn khi công ty lên 150. Chuyên mục này bàn về số hóa, chuẩn hóa quy trình, thiết kế workflow và những thói quen vận hành quyết định một hệ thống, dù là ERP, AI hay công cụ nào khác, có thực sự chạy được sau khi triển khai hay không.</p>

      <p class="mt-6">
        <strong>Bắt đầu từ đây — Bài viết Pillar:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/business-operations/chuyen-doi-so-doanh-nghiep-san-xuat" class="text-primary hover:underline">Chuyển đổi số với doanh nghiệp sản xuất — thực sự là gì →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Góc nhìn OKELAS:</strong>
        <a href="/why/tai-lieu-den-van-hanh" class="text-primary hover:underline ml-1">Từ Tài liệu đến Vận hành →</a>
      </p>

      <p class="mt-3">
        <strong>Đánh giá ngay:</strong>
        <a href="/readiness/digitalization" class="text-primary hover:underline ml-1">Hoàn thành Đánh giá Sẵn sàng Số hóa →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Tất cả bài viết về Business & Operations</h2>
      <ul class="space-y-4">
        {bizOpsArticles.map((article) => {
          const coverImages: Record<string, string> = {
            'chuyen-doi-so-doanh-nghiep-san-xuat': 'dt-01b-og-cover-vi.png',
            'giai-doan-so-hoa-doanh-nghiep': 'lv-04-og-cover-vi.png',
            'paperless-khong-phai-chuyen-doi-so': 'pl-04-og-cover-vi.png',
            'nhieu-phan-mem-chua-so-hoa': 'sw-04-og-cover-vi.png',
            'lo-trinh-dms-eqms-knowledge-os': 'rm-05-og-cover-vi.png',
            'so-hoa-ho-so-iso-gmp': 'so-05-og-cover-vi.png',
            'progressive-eqms-la-gi': 'pe-05-og-cover-vi.png',
            'chi-phi-khong-so-hoa': 'cn-05-og-cover-vi.png',
            'du-an-chuyen-doi-so-that-bai': 'dp-06-og-cover-vi.png',
            'buoc-tiep-theo-so-hoa-co-nghia-kinh-te': 'nx-05-og-cover-vi.png',
          };
          const imageName = coverImages[article.id] || '';
          const coverImagePath = `/assets/images/insights/${article.id}/${imageName}`;

          return (
          <li key={article.id} class="flex items-start gap-4 group">
            <div class="flex-shrink-0 w-20 h-24 overflow-hidden rounded bg-gray-200">
              <img
                src={coverImagePath}
                alt={article.data.title}
                class="w-full h-full object-cover"
              />
            </div>
            <a
              href={`/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                  {article.data.category}
                </span>
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Digitalization Readiness Assessment',
        href: '/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Digitalize Operations',
        href: '/solutions/so-hoa-van-hanh',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Doanh nghiệp của bạn đang ở đâu?</Fragment>
    <Fragment slot="subtitle">
      Hoàn thành đánh giá để hiểu rõ vị trí hiện tại và bước tiếp theo có ý nghĩa kinh tế là gì.
    </Fragment>
  </CallToAction>
</Layout>
