---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Business & Operations — OKELAS Insights',
  description:
    'Digitalization, process standardization, workflow and the operational habits that determine whether any system actually works once in place.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Business & Operations" />

  <Content
    content={`
      <p>Most operational problems don't announce themselves as "we need to digitalize" or "we need better workflows." They show up as a supervisor doing the same fix for the third time this month, or a process that worked fine at 50 people and is starting to break at 150. This category covers digitalization, process standardization, workflow design, and the operational habits that determine whether any system — ERP, AI, or otherwise — actually works once it's in place.</p>

      <p class="mt-6">
        <strong>Start here:</strong>
        <a href="/why/documents-to-operations" class="text-primary hover:underline ml-1">From Documents to Operations — why OKELAS starts where it does →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/readiness/digitalization" class="text-primary hover:underline ml-1">Take the Digitalization Readiness Assessment →</a>
      </p>

      <div class="mt-8">
        <p class="font-semibold mb-3">Topics we're covering here <span class="font-normal text-muted">(more added regularly):</span></p>
        <ul class="space-y-2 text-muted">
          <li>Digitalization — what it actually means versus what gets sold as it</li>
          <li>Process standardization — why documented isn't the same as followed</li>
          <li>Workflow — where automation helps and where it just moves the same bottleneck faster</li>
          <li>Operational excellence — for SMEs, not just for enterprises with a dedicated ops team</li>
        </ul>
      </div>
    `}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Digitalization Readiness Assessment',
        href: '/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Digitalize Operations',
        href: '/solutions/digitalize-operations',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Where is your operation right now?</Fragment>
    <Fragment slot="subtitle">
      Take the assessment to understand where you stand and what the next meaningful step looks like for your business.
    </Fragment>
  </CallToAction>
</Layout>
