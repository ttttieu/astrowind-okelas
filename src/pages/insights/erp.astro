---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import { getArticlesByCategory } from '~/lib/insights';
import type { ImageMetadata } from 'astro';

const metadata = {
  title: 'ERP — OKELAS Insights',
  description:
    "Why ERP projects succeed or fail, and what \"ERP readiness\" concretely means before you sign a contract.",
};

const { grouped } = await getArticlesByCategory('vi');
let erpArticles = grouped.erp || [];

// Import all VI ERP cover images from src/assets (flat directory)
const viCoverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/insights/*-00-og-cover-vi.png',
  { eager: true }
);
const viCovers: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(viCoverGlob)) {
  const match = path.match(/\/([a-z]+)-00-og-cover-vi\.png$/);
  if (match) viCovers[match[1]] = mod.default;
}

// Map VI article ID → cover image prefix
const articleCoverPrefix: Record<string, string> = {
  'tai-sao-du-an-erp-that-bai': 'erpf',
  'doanh-nghiep-san-sang-trien-khai-erp': 'erpr',
  'chuan-hoa-quy-trinh-truoc-erp': 'erps',
  'data-readiness-trien-khai-erp': 'erpd',
  'scope-creep-trong-du-an-erp': 'erpc',
  'customization-erp-rui-ro': 'erpk',
  'user-adoption-erp': 'erpu',
  'ke-toan-san-sang-erp': 'erpa',
  'erp-cho-doanh-nghiep-san-xuat': 'erpm',
  'co-erp-van-dung-excel': 'erpx',
  'quan-tri-erp-governance': 'erpg',
  'khoang-cach-trien-khai-va-ap-dung-erp': 'erpi',
  'khai-thac-du-lieu-erp': 'erpt',
};

// Define article order: pillar first, then 1.1 to 1.12
const articleOrder: Record<string, number> = {
  'tai-sao-du-an-erp-that-bai': 0, // PILLAR
  'doanh-nghiep-san-sang-trien-khai-erp': 1, // 1.1
  'chuan-hoa-quy-trinh-truoc-erp': 2, // 1.2
  'data-readiness-trien-khai-erp': 3, // 1.3
  'scope-creep-trong-du-an-erp': 4, // 1.4
  'customization-erp-rui-ro': 5, // 1.5
  'user-adoption-erp': 6, // 1.6
  'ke-toan-san-sang-erp': 7, // 1.7
  'erp-cho-doanh-nghiep-san-xuat': 8, // 1.8
  'co-erp-van-dung-excel': 9, // 1.9
  'quan-tri-erp-governance': 10, // 1.10
  'khoang-cach-trien-khai-va-ap-dung-erp': 11, // 1.11
  'khai-thac-du-lieu-erp': 12, // 1.12
};

// Sort articles by order
erpArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="ERP" />

  <Content
    content={`
      <p>ERP có vấn đề về danh tiếng, và điều đó phần lớn là xứng đáng — một phần không nhỏ các dự án ERP vượt quá ngân sách, lỡ hạn chót hoặc không đạt được những gì đã hứa. Phần này xem xét tại sao điều đó xảy ra, "sẵn sàng cho ERP" thực sự có nghĩa là gì, và những gì cần kiểm tra trước — và sau — khi ký hợp đồng.</p>

      <p class="mt-6">
        <strong>Bắt đầu từ đây — Bài viết Pillar:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/erp/tai-sao-du-an-erp-that-bai" class="text-primary hover:underline">Tại sao dự án ERP không đạt mục tiêu — và vấn đề thực sự không nằm ở phần mềm →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Góc nhìn OKELAS:</strong>
        <a href="/why/tai-sao-readiness-truoc-erp" class="text-primary hover:underline ml-1">Tại sao trước ERP — những gì nghiên cứu sẵn sàng thực sự nói lên →</a>
      </p>

      <p class="mt-3">
        <strong>Đánh giá ngay:</strong>
        <a href="/readiness/erp" class="text-primary hover:underline ml-1">Hoàn thành Đánh giá Sẵn sàng ERP →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Tất cả bài viết về ERP</h2>
      <ul class="space-y-6">
        {erpArticles.map((article) => {
          const prefix = articleCoverPrefix[article.id];
          const coverImg = prefix ? viCovers[prefix] : undefined;
          return (
          <li key={article.id} class="flex items-start gap-6 group">
            {coverImg && (
              <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                <Image
                  src={coverImg}
                  alt={article.data.title}
                  class="w-full h-auto block"
                />
              </div>
            )}
            <a
              href={`/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                {article.data.contentType && (
                  <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                    {article.data.contentType}
                  </span>
                )}
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'ERP Readiness Assessment',
        href: '/readiness/erp',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'ERP Readiness Solution',
        href: '/solutions/erp-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Is your organization ready for ERP?</Fragment>
    <Fragment slot="subtitle">
      The ERP Readiness Assessment evaluates processes, data, and governance — the factors that determine whether an ERP project delivers or struggles.
    </Fragment>
  </CallToAction>
</Layout>
