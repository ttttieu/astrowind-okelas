---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'ERP — OKELAS Insights',
  description:
    "Why ERP projects succeed or fail, and what \"ERP readiness\" concretely means before you sign a contract.",
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="ERP" />

  <Content
    content={`
      <p>ERP has a reputation problem, and it's mostly earned — a meaningful share of ERP projects run over budget, past deadline, or fail to deliver what was promised. This category looks at why that happens, what "ERP readiness" concretely means, and what to check before — and after — a contract gets signed.</p>

      <p class="mt-6">
        <strong>Start here — Pillar article:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/erp/tai-sao-du-an-erp-that-bai" class="text-primary hover:underline">Why ERP Projects Fail — and What the Software Cannot Fix →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Why OKELAS perspective:</strong>
        <a href="/why/why-before-erp" class="text-primary hover:underline ml-1">Why Before ERP — what the readiness research actually says →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/readiness/erp" class="text-primary hover:underline ml-1">Take the ERP Readiness Assessment →</a>
      </p>

      <div class="mt-8">
        <p class="font-semibold mb-3">Topics we're covering here <span class="font-normal text-muted">(more added regularly):</span></p>
        <ul class="space-y-2 text-muted">
          <li>ERP readiness — what it means beyond "do we need ERP"</li>
          <li>Why ERP projects fail — the patterns behind the headline statistics</li>
          <li>ERP data — why clean data is harder than it sounds, and why it matters more than expected</li>
          <li>ERPNext — what it is, and where it fits for a manufacturing SME</li>
        </ul>
      </div>
    `}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'ERP Readiness Assessment',
        href: '/readiness/erp',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'ERP Readiness Solution',
        href: '/solutions/erp-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Is your organization ready for ERP?</Fragment>
    <Fragment slot="subtitle">
      The ERP Readiness Assessment evaluates processes, data, and governance — the factors that determine whether an ERP project delivers or struggles.
    </Fragment>
  </CallToAction>
</Layout>
