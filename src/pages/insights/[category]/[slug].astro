---
import { getCollection, render } from 'astro:content';
import InsightArticleLayout from '~/layouts/InsightArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('insights', ({ data }) => !data.draft && data.lang === 'vi');
  return articles.map((article) => ({
    params: {
      category: article.data.category,
      slug: article.id,
    },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const clusterLabel: Record<string, string> = {
  'business-operations': 'Business & Operations',
  'knowledge-management': 'Knowledge Management',
  erp: 'ERP',
  ai: 'AI',
  compliance: 'Compliance',
};
---

<InsightArticleLayout
  title={article.data.title}
  description={article.data.description}
  translationId={article.data.translationId}
  lang={article.data.lang}
  contentType={article.data.contentType}
  cluster={clusterLabel[article.data.category] as any}
  funnelStage={article.data.funnelStage?.[0]}
  publishDate={article.data.publishDate?.toISOString().slice(0, 10)}
  selfAssessmentHref={article.data.assessmentHref}
>
  <Content />
</InsightArticleLayout>
