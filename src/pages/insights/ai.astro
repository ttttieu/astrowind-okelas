---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'AI — OKELAS Insights',
  description:
    "What separates AI that generates content from AI that an operations team can actually trust with a decision — readiness, agentic AI, Copilots, and organizational AI.",
};

const { grouped } = await getArticlesByCategory('vi');
const aiArticles = grouped.ai || [];

// Pillar 2: AI Readiness series
const pillar2Order: Record<string, number> = {
  'ai-readiness-doanh-nghiep': 0,
  'ai-tang-nang-suat-doanh-nghiep': 1,
  'ai-nang-suat-va-tri-thuc-tong-the': 2,
  'rag-la-gi-han-che-ai': 3,
  'dieu-kien-trien-khai-ai-van-hanh': 4,
  'du-lieu-khong-co-context-ai': 5,
  'ai-agent-doanh-nghiep': 6,
  'evidence-based-ai-kiem-chung': 7,
  'lo-trinh-ai-thuc-te-manufacturing-sme': 8,
  'ai-iso-gmp-compliance': 9,
  'organizational-ai-doanh-nghiep': 10,
};

// Pillar 6: AI Control Layer series
const pillar6Order: Record<string, number> = {
  'kiem-soat-ai-doanh-nghiep': 0,
  'ai-vuot-khoi-chatbot': 1,
  'ai-giai-quyet-bai-toan-phuc-tap': 2,
  'agentic-ai-vs-ai-assistant-vi': 3,
  'ai-tu-chu-control-problem': 4,
  'ai-vuot-qua-gioi-han-nghien-cuu': 5,
  'multi-agent-ai-phoi-hop': 6,
  'ai-khong-minh-bach-hanh-dong': 7,
  'ai-agent-va-cybersecurity': 8,
  'trao-quyen-ai-agent-doanh-nghiep': 9,
  'chatbot-sai-khac-agent-sai': 10,
  'ai-authority-vs-intelligence-vi': 11,
  'least-privilege-cho-ai': 12,
  'ai-control-layer-doanh-nghiep': 13,
  'kvm-la-gi': 14,
  'ai-ly-luan-vs-su-that-to-chuc': 15,
  'ho-so-quyen-han-ai-agent': 16,
  'ai-employee-tu-assistant': 17,
  'ai-safety-frontier-va-doanh-nghiep': 18,
  'frontier-safety-vs-enterprise-control': 19,
  'kvm-control-layer-ai-doanh-nghiep': 20,
};

const pillar2Articles = aiArticles
  .filter((article) => article.id in pillar2Order)
  .sort((a, b) => (pillar2Order[a.id] ?? 999) - (pillar2Order[b.id] ?? 999));

const pillar6Articles = aiArticles
  .filter((article) => article.id in pillar6Order)
  .sort((a, b) => (pillar6Order[a.id] ?? 999) - (pillar6Order[b.id] ?? 999));

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="AI" />

  <Content
    content={`
      <p>AI có thể giúp một nhóm nhỏ tạo ra output mà trước đây cần một nhóm lớn hơn. Nhưng điều đó không giống với việc tổ chức trở nên khả năng hơn — và với nhiều doanh nghiệp, khoảng cách giữa "chúng tôi dùng AI" và "AI thực sự hữu ích trong vận hành hàng ngày" lớn hơn vẻ bề ngoài. Phần này bao gồm hai chuỗi bài viết: readiness (điều kiện để AI thực sự hữu ích) và AI control (khi AI agent bắt đầu hành động, không chỉ trả lời).</p>

      <p class="mt-6">
        <strong>Chuỗi 1 — AI Readiness:</strong>
        <a href="/insights/ai/ai-readiness-doanh-nghiep" class="text-primary hover:underline ml-1">Tại sao AI không tự động làm doanh nghiệp thông minh hơn →</a>
      </p>

      <p class="mt-3">
        <strong>Chuỗi 2 — AI Control Layer:</strong>
        <a href="/insights/ai/kiem-soat-ai-doanh-nghiep" class="text-primary hover:underline ml-1">AI được phép làm đến đâu? Tại sao doanh nghiệp cần một control layer →</a>
      </p>

      <p class="mt-5">
        <strong>Đánh giá ngay:</strong>
        <a href="/readiness/ai" class="text-primary hover:underline ml-1">Hoàn thành Đánh giá AI Readiness →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white">Chuỗi 1: AI Readiness</h2>
        <p class="text-muted mb-6">Những điều kiện quyết định AI có thực sự hữu ích trong vận hành hay không.</p>
        <ul class="space-y-4 mb-12">
          {pillar2Articles.map((article) => (
            <li key={article.id} class="flex items-start gap-4 group">
              <a
                href={`/insights/${article.data.category}/${article.id}`}
                class="flex-1 hover:underline"
              >
                <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                  {article.data.title}
                </div>
              </a>
              {article.data.funnelStage?.[0] && (
                <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                  {article.data.funnelStage[0]}
                </span>
              )}
            </li>
          ))}
        </ul>

        <h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white">Chuỗi 2: AI Control Layer</h2>
        <p class="text-muted mb-6">Khi AI agent bắt đầu hành động thay vì chỉ trả lời — ai kiểm soát, phạm vi nào, và làm sao.</p>
        <ul class="space-y-4">
          {pillar6Articles.map((article) => (
            <li key={article.id} class="flex items-start gap-4 group">
              <a
                href={`/insights/${article.data.category}/${article.id}`}
                class="flex-1 hover:underline"
              >
                <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                  {article.data.title}
                </div>
              </a>
              {article.data.funnelStage?.[0] && (
                <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                  {article.data.funnelStage[0]}
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'AI Readiness Assessment',
        href: '/readiness/ai',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'AI Readiness Solution',
        href: '/solutions/ai-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Doanh nghiệp bạn sẵn sàng cho AI?</Fragment>
    <Fragment slot="subtitle">
      Đánh giá AI Readiness đánh giá sáu điều kiện quyết định xem AI có thể tạo ra giá trị vận hành thực sự hay chỉ tạo ra output nhanh hơn.
    </Fragment>
  </CallToAction>
</Layout>
