---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'AI — OKELAS Insights',
  description:
    "What separates AI that generates content from AI that an operations team can actually trust with a decision — readiness, agentic AI, Copilots, and organizational AI.",
};

const { grouped } = await getArticlesByCategory('vi');
let aiArticles = grouped.ai || [];

// Define article order: pillars first, then analysis articles
const articleOrder: Record<string, number> = {
  'ai-readiness-doanh-nghiep': 0, // PILLAR 1
  'kiem-soat-ai-doanh-nghiep': 1, // PILLAR 2
  'ai-tang-nang-suat-doanh-nghiep': 2, // 2.1
  'ai-nang-suat-va-tri-thuc-tong-the': 3, // 2.2
  'rag-la-gi-han-che-ai': 4, // 2.3
  'dieu-kien-trien-khai-ai-van-hanh': 5, // 2.4
  'du-lieu-khong-co-context-ai': 6, // 2.5
  'ai-agent-doanh-nghiep': 7, // 2.6
  'evidence-based-ai-kiem-chung': 8, // 2.7
  'lo-trinh-ai-thuc-te-manufacturing-sme': 9, // 2.8
  'ai-iso-gmp-compliance': 10, // 2.9
  'organizational-ai-doanh-nghiep': 11, // 2.10
};

// Sort articles by order
aiArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="AI" />

  <Content
    content={`
      <p>AI có thể giúp một nhóm nhỏ tạo ra output mà trước đây cần một nhóm lớn hơn. Nhưng điều đó không giống với việc tổ chức trở nên khả năng hơn — và với nhiều doanh nghiệp, khoảng cách giữa "chúng tôi dùng AI" và "AI thực sự hữu ích trong vận hành hàng ngày" lớn hơn vẻ bề ngoài. Phần này về việc đóng khoảng cách đó: readiness, agentic AI, Copilots, và những gì cần để AI hiểu một doanh nghiệp cụ thể thay vì chỉ trả lời câu hỏi trôi chảy.</p>

      <p class="mt-6">
        <strong>Bắt đầu từ đây — Bài viết Pillar:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/ai/ai-readiness-doanh-nghiep" class="text-primary hover:underline">AI Readiness: tại sao AI không tự động làm doanh nghiệp thông minh hơn →</a></li>
        <li><a href="/insights/ai/kiem-soat-ai-doanh-nghiep" class="text-primary hover:underline">Nên cho phép AI đi bao xa? Tầm quan trọng của AI Control Layer trong doanh nghiệp →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Góc nhìn OKELAS:</strong>
        <a href="/why/tai-sao-readiness-truoc-ai" class="text-primary hover:underline ml-1">Tại sao readiness trước AI — nó có nghĩa gì trong thực tế →</a>
      </p>

      <p class="mt-3">
        <strong>Đánh giá ngay:</strong>
        <a href="/readiness/ai" class="text-primary hover:underline ml-1">Hoàn thành Đánh giá AI Readiness →</a>
      </p>

      <div class="mt-8">
        <p class="font-semibold mb-3">Các chủ đề chúng tôi đang bao quát <span class="font-normal text-muted">(tiếp tục bổ sung):</span></p>
        <ul class="space-y-2 text-muted">
          <li>AI readiness — những điều kiện quyết định AI có thực sự hữu ích hay không</li>
          <li>AI trong vận hành — ứng dụng nào hiệu quả hôm nay, ứng dụng nào chưa đáng tin cậy</li>
          <li>AI Copilot — yếu tố nào làm cho trợ lý AI đáng tin cậy trong quyết định vận hành thực tế</li>
          <li>Agentic AI — điều gì thay đổi khi AI không chỉ trả lời, mà còn hành động</li>
          <li>Organizational AI — sự khác biệt giữa AI thông minh và AI hiểu doanh nghiệp</li>
        </ul>
      </div>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Tất cả bài viết về AI</h2>
      <ul class="space-y-4">
        {aiArticles.map((article) => (
          <li key={article.id} class="flex items-start gap-4 group">
            <a
              href={`/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
            </a>
            {article.data.funnelStage?.[0] && (
              <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                {article.data.funnelStage[0]}
              </span>
            )}
          </li>
        ))}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'AI Readiness Assessment',
        href: '/readiness/ai',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'AI Readiness Solution',
        href: '/solutions/ai-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Doanh nghiệp bạn sẵn sàng cho AI?</Fragment>
    <Fragment slot="subtitle">
      Đánh giá AI Readiness đánh giá sáu điều kiện quyết định xem AI có thể tạo ra giá trị vận hành thực sự hay chỉ tạo ra output nhanh hơn.
    </Fragment>
  </CallToAction>
</Layout>
