---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import { getArticlesByCategory } from '~/lib/insights';
import type { ImageMetadata } from 'astro';

const metadata = {
  title: 'Compliance & eQMS — OKELAS Insights',
  description:
    'Từ QMS giấy đến eQMS vận hành được: document control, CAPA, audit nội bộ, nonconformance và tất cả những gì ISO 9001 thực sự yêu cầu.',
};

const { grouped } = await getArticlesByCategory('vi');
let complianceArticles = grouped.compliance || [];

// Import all VI compliance cover images from src/assets (flat directory)
const viCoverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/insights/*-00-og-cover-vi.png',
  { eager: true }
);
const viCovers: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(viCoverGlob)) {
  const match = path.match(/\/([a-z]+)-00-og-cover-vi\.png$/);
  if (match) viCovers[match[1]] = mod.default;
}

// Map VI article ID → cover image prefix
const articleCoverPrefix: Record<string, string> = {
  'eqms-cho-doanh-nghiep-san-xuat': 'aeqm',
  'tu-qms-giay-sang-eqms': 'apqm',
  'iso-9001-co-can-phan-mem-qms': 'aiso',
  'eqms-sme-don-gian': 'aesm',
  'document-control-iso-9001': 'adcn',
  'capa-iso-9001-hieu-qua': 'acapa',
  'nonconformance-iso-9001': 'anc',
  'internal-audit-iso-9001-hieu-qua': 'aia',
  'training-records-iso-9001': 'atrc',
  'supplier-qualification-iso-9001': 'asq',
  'risk-management-iso-9001': 'arm',
  'management-review-iso-9001': 'amr',
  'okelas-eqms-to-chuc': 'aoe',
  'evidence-eqms-kiem-chung': 'aet',
  'tu-eqms-den-knowledge-os': 'akos',
};

// Pillar first, then C01–C14
const articleOrder: Record<string, number> = {
  'eqms-cho-doanh-nghiep-san-xuat': 0,      // PILLAR
  'tu-qms-giay-sang-eqms': 1,               // C01
  'iso-9001-co-can-phan-mem-qms': 2,        // C02
  'eqms-sme-don-gian': 3,                   // C03
  'document-control-iso-9001': 4,           // C04
  'capa-iso-9001-hieu-qua': 5,              // C05
  'nonconformance-iso-9001': 6,             // C06
  'internal-audit-iso-9001-hieu-qua': 7,    // C07
  'training-records-iso-9001': 8,           // C08
  'supplier-qualification-iso-9001': 9,     // C09
  'risk-management-iso-9001': 10,           // C10
  'management-review-iso-9001': 11,         // C11
  'okelas-eqms-to-chuc': 12,                // C12
  'evidence-eqms-kiem-chung': 13,           // C13
  'tu-eqms-den-knowledge-os': 14,           // C14
};

complianceArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Compliance & eQMS" />

  <Content
    content={`
      <p>eQMS không phải chỉ là số hóa hồ sơ giấy — đó là cách tổ chức hệ thống quản lý chất lượng để mỗi hành động có người chịu trách nhiệm, có bằng chứng và có thể truy vết. Phần này đi từ nền tảng ISO 9001 đến các thành phần vận hành thực tế: document control, CAPA, nonconformance, audit nội bộ, đào tạo và đánh giá nhà cung cấp.</p>

      <p class="mt-6">
        <strong>Bắt đầu từ đây — Bài viết Pillar:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/insights/compliance/eqms-cho-doanh-nghiep-san-xuat" class="text-primary hover:underline">eQMS cho doanh nghiệp sản xuất — hướng dẫn thực hành từ ISO 9001 đến vận hành số →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Góc nhìn OKELAS:</strong>
        <a href="/why/tai-sao-khong-bat-dau-hoan-chinh" class="text-primary hover:underline ml-1">Tại sao không bắt đầu hoàn chỉnh — Progressive eQMS là gì →</a>
      </p>

      <p class="mt-3">
        <strong>Đánh giá ngay:</strong>
        <a href="/readiness/digitalization-level" class="text-primary hover:underline ml-1">Hoàn thành Đánh giá Mức độ Số hóa →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Tất cả bài viết về Compliance & eQMS</h2>
      <ul class="space-y-6">
        {complianceArticles.map((article) => {
          const prefix = articleCoverPrefix[article.id];
          const coverImg = prefix ? viCovers[prefix] : undefined;
          return (
          <li key={article.id} class="flex items-start gap-6 group">
            {coverImg && (
              <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                <Image
                  src={coverImg}
                  alt={article.data.title}
                  class="w-full h-auto block"
                />
              </div>
            )}
            <a
              href={`/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                {article.data.contentType && (
                  <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                    {article.data.contentType}
                  </span>
                )}
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Đánh giá Mức độ Số hóa',
        href: '/readiness/digitalization-level',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Progressive eQMS Solution',
        href: '/solutions/progressive-eqms',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Doanh nghiệp đang ở đâu trên hành trình số hóa chất lượng?</Fragment>
    <Fragment slot="subtitle">
      Đánh giá Mức độ Số hóa giúp xác định điểm xuất phát thực tế — từ hồ sơ giấy đến eQMS vận hành được — và những bước tiếp theo có ý nghĩa kinh tế nhất.
    </Fragment>
  </CallToAction>
</Layout>
