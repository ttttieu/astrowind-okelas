---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import AssessmentForm from '~/components/widgets/AssessmentForm.astro';

const metadata = {
  title: "ERP Readiness Assessment - OKELAS",
  description: "Đánh giá tính sẵn sàng của doanh nghiệp trước khi triển khai hệ thống ERP.",
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Readiness Assessment"
    title="ERP Readiness"
    subtitle="Xác định rõ ràng những khoảng trống quy trình và vấn đề dữ liệu trước khi triển khai"
  />

  <AssessmentForm assessmentId="erp_readiness" language="vi" />
</Layout>
