---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import HeroActionCard from '~/components/ui/HeroActionCard.astro';
import { SITE, METADATA } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'OKELAS — Quản lý tri thức doanh nghiệp sản xuất vừa và nhỏ',
  description:
    'OKELAS giúp doanh nghiệp sản xuất kết nối quy trình, workflow, sự kiện và bằng chứng thành tri thức vận hành chung. Bắt đầu bằng việc đánh giá năng lực doanh nghiệp.',
  ignoreTitleTemplate: true,
  openGraph: {
    locale: 'vi',
  },
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: 'vi',
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle
      ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] }
      : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero -->
  <Hero
    tagline="Organization Knowledge Operating System for Manufacturers"
    image={{ src: '~/assets/images/okelas-diagram.png', alt: 'OKELAS Architecture Overview' }}
  >
    <Fragment slot="title">
      Your computer runs on an operating system. <span class="text-accent dark:text-white"
        >Your company runs on a few people's memory.</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      OKELAS giúp doanh nghiệp sản xuất kết nối con người, quy trình, tài liệu, sự kiện và bằng chứng vào một bối
      cảnh vận hành chung — để thông tin trở thành quyết định và hành động, thay vì nằm rải rác trong file, phần mềm
      và kinh nghiệm cá nhân.
    </Fragment>

    <Fragment slot="actions">
      <div
        class="w-full max-w-[1640px] m-auto grid grid-cols-1 sm:grid-cols-2 gap-3 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        <HeroActionCard
          title="Assess Your Business"
          description="Bắt đầu bằng đánh giá năng lực vận hành của doanh nghiệp theo 6 trụ cột."
          href="/readiness"
          icon="tabler:clipboard-check"
          variant="primary"
          ariaLabel="Assess Your Business: Đánh giá năng lực vận hành theo 6 trụ cột"
        />
        <HeroActionCard
          title="What is OKELAS?"
          description="Vận hành bằng quy trình và tri thức, không dựa vào trí nhớ của từng người."
          href="#what-is-okelas"
          variant="secondary"
          icon="tabler:info-circle"
          ariaLabel="What is OKELAS?"
        />
      </div>
    </Fragment>
  </Hero>

  <!-- Problem Section -->
  <section id="problem" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6 font-heading">
        You Don't Lack Software. You Lack a Shared Context.
      </h2>
      <p class="text-lg text-muted mb-6">
        Nhiều doanh nghiệp sản xuất vừa và nhỏ hiện đã có phần mềm kế toán. Họ đã có ERP hoặc đang chuẩn bị triển
        khai ERP, có hệ thống ISO/GMP với hàng trăm SOP và biểu mẫu, và nhân viên đã bắt đầu dùng AI. Dù vậy, những
        tình huống sau vẫn rất quen thuộc:
      </p>
      <ul class="space-y-3 text-muted mb-8 pl-2">
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>SOP có, nhưng mỗi ca, mỗi người làm một kiểu.
        </li>
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>Một nhân sự chủ chốt nghỉ việc, cả bộ phận mất nhiều tháng
          để "học lại".
        </li>
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>Mỗi lần audit, đội chất lượng mất nhiều tuần để lục hồ sơ.
        </li>
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>ERP đã chạy, nhưng con số quan trọng vẫn nằm trong Excel và
          email.
        </li>
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>Câu hỏi "vì sao lô hàng này có vấn đề?" phải đi qua ba bộ
          phận mới có câu trả lời.
        </li>
        <li class="flex gap-3 items-start">
          <span class="text-accent shrink-0 mt-1">—</span>Nhân viên viết nhanh hơn nhờ AI, nhưng công việc không trôi
          nhanh hơn.
        </li>
      </ul>
      <p class="text-lg text-muted">
        Các vấn đề này trông có vẻ riêng lẻ, nhưng phần lớn có chung một gốc. <strong class="text-default"
          >Dữ liệu và tri thức của doanh nghiệp đang bị phân tán trong phần mềm, trong file và trong đầu người. Doanh
          nghiệp chưa có lớp nào nối chúng lại thành một cách hiểu chung về việc doanh nghiệp thực sự vận hành ra
          sao.</strong
        >
      </p>
    </div>
  </section>

  <!-- OS Analogy Section -->
  <section id="os-analogy" class="bg-gray-50 dark:bg-slate-900/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16 lg:py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6 font-heading">
          A Simple Analogy: The Operating System
        </h2>
        <p class="text-lg text-muted mb-4">
          Máy tính của bạn chạy Windows hoặc macOS. Không ai mua máy tính vì hệ điều hành. Nhưng nếu không có hệ
          điều hành, các ứng dụng không dùng chung được file và không biết ai là người dùng, ai được làm gì. Hệ điều
          hành là <strong class="text-default">môi trường chung</strong> để mọi thứ hoạt động cùng nhau.
        </p>
        <p class="text-lg text-muted mb-4">
          Doanh nghiệp cũng có "ứng dụng": ERP, phần mềm kế toán, hệ thống chất lượng, Excel, Word, email, nhóm
          chat, công cụ AI. Doanh nghiệp cũng có "phần cứng": con người, máy móc, nhà xưởng.
        </p>
        <p class="text-lg text-muted mb-4">
          Thứ thường thiếu là lớp ở giữa. Đó là nơi quy trình, quyền hạn, tài liệu, sự kiện và bằng chứng được mọi
          người hiểu theo cùng một cách.
        </p>
        <p class="text-lg text-muted mb-8">
          Khi thiếu lớp này, <strong class="text-default">con người phải tự đóng vai hệ điều hành</strong>: họ nhớ,
          nhắc việc, chuyển tiếp, đối chiếu và giải thích lại. Doanh nghiệp vẫn chạy, nhưng chạy nhờ trí nhớ và sự
          tận tụy của một vài người. Khi những người đó bận, nghỉ phép hoặc nghỉ việc, cả hệ thống chậm lại.
        </p>
        <p class="text-xl font-semibold text-accent">OKELAS là lớp còn thiếu đó.</p>
      </div>
    </div>
  </section>

  <!-- What is OKELAS Section -->
  <section id="what-is-okelas" class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6 font-heading">What Is OKELAS?</h2>
      <blockquote
        class="border-l-4 border-accent pl-6 py-4 mb-8 bg-blue-50 dark:bg-blue-900/10 rounded-r-lg not-italic"
      >
        <p class="text-lg">
          <strong
            >OKELAS là Organization Knowledge Operating System, tức hệ điều hành tri thức của tổ chức, dành cho doanh
            nghiệp sản xuất vừa và nhỏ.</strong
          > Hiện nhiều doanh nghiệp vận hành dựa trên tài liệu rời rạc và kinh nghiệm cá nhân. OKELAS giúp họ chuyển
          sang vận hành dựa trên quy trình, workflow, bằng chứng và tri thức của tổ chức.
        </p>
      </blockquote>
      <p class="text-lg text-muted mb-6">Nói đơn giản, OKELAS kết nối các mắt xích hiện đang nằm ở những nơi khác nhau:</p>
      <div class="overflow-x-auto mb-8 rounded-xl border border-gray-200 dark:border-slate-700">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-800">
              <th class="px-4 py-3 text-left font-semibold border-b border-gray-200 dark:border-slate-700">Mắt xích</th>
              <th class="px-4 py-3 text-left font-semibold border-b border-gray-200 dark:border-slate-700">Nghĩa là</th>
              <th class="px-4 py-3 text-left font-semibold border-b border-gray-200 dark:border-slate-700"
                >Hiện thường nằm ở đâu</th
              >
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Process</td>
              <td class="px-4 py-3 text-muted">Việc <em>nên</em> được làm như thế nào</td>
              <td class="px-4 py-3 text-muted">File SOP, sổ tay ISO</td>
            </tr>
            <tr class="border-b border-gray-100 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Workflow</td>
              <td class="px-4 py-3 text-muted">Việc <em>thực sự</em> đi qua ai, qua bước nào, ai duyệt</td>
              <td class="px-4 py-3 text-muted">Email, nhóm chat, lời nhắc miệng</td>
            </tr>
            <tr class="border-b border-gray-100 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Event</td>
              <td class="px-4 py-3 text-muted">Điều gì đã xảy ra, khi nào, ở đâu</td>
              <td class="px-4 py-3 text-muted">Biên bản, nhật ký ca, Excel</td>
            </tr>
            <tr class="border-b border-gray-100 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Evidence</td>
              <td class="px-4 py-3 text-muted">Hồ sơ chứng minh việc đã được làm đúng</td>
              <td class="px-4 py-3 text-muted">Thư mục, giấy tờ, máy tính cá nhân</td>
            </tr>
            <tr class="border-b border-gray-100 dark:border-slate-800 hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Knowledge</td>
              <td class="px-4 py-3 text-muted">Điều tổ chức đã học được và dùng lại được</td>
              <td class="px-4 py-3 text-muted">Trong đầu người có kinh nghiệm</td>
            </tr>
            <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50">
              <td class="px-4 py-3 font-medium">Decision → Action</td>
              <td class="px-4 py-3 text-muted">Ai quyết định, dựa trên gì, việc gì xảy ra tiếp theo</td>
              <td class="px-4 py-3 text-muted">Cuộc họp, tin nhắn</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-lg text-muted mb-8">
        Khi các mắt xích này được nối với nhau, doanh nghiệp không chỉ <em>lưu trữ</em> thông tin mà còn <em>hiểu</em>
        và <em>dùng</em> được thông tin đó trong vận hành hằng ngày. Đó là ý nghĩa thực tế của quản lý tri thức trong
        doanh nghiệp sản xuất.
      </p>
      <div class="rounded-xl bg-gray-50 dark:bg-slate-800/50 p-6 border border-gray-200 dark:border-slate-700">
        <p class="text-sm font-semibold text-accent mb-4">
          Ví dụ minh họa <span class="text-muted font-normal"
            >(tình huống giả định, không phải case khách hàng)</span
          >: một lô sản phẩm bị phát hiện lệch thông số.
        </p>
        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div class="rounded-lg bg-red-50 dark:bg-red-900/10 p-4 border border-red-200 dark:border-red-800/30">
            <p class="font-semibold text-red-600 dark:text-red-400 mb-2">Khi chưa có lớp vận hành chung:</p>
            <p class="text-muted">
              QA mở Excel, gọi trưởng ca, tìm biên bản kiểm tra và hỏi người có kinh nghiệm xem lần trước xử lý thế
              nào. Cách xử lý cuối cùng nằm trong một email mà lần sau ít ai tìm lại được.
            </p>
          </div>
          <div class="rounded-lg bg-green-50 dark:bg-green-900/10 p-4 border border-green-200 dark:border-green-800/30">
            <p class="font-semibold text-green-600 dark:text-green-400 mb-2">Theo cách tiếp cận của OKELAS:</p>
            <p class="text-muted">
              Sự kiện được ghi nhận và gắn với lô hàng, công đoạn, phiên bản SOP đang áp dụng, người phụ trách và
              các hồ sơ liên quan. Người xử lý biết bước tiếp theo và ai cần phê duyệt. Cách xử lý trở thành tri
              thức tổ chức cho lần sau.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What OKELAS is NOT -->
  <Features2
    id="what-not"
    tagline="Để rõ ràng"
    title="What OKELAS Is Not"
    subtitle="Để tránh hiểu nhầm, OKELAS không phải những thứ sau."
    columns={2}
    isDark={false}
    classes={{ container: 'max-w-5xl' }}
    items={[
      {
        title: 'Không phải chatbot AI',
        description:
          'AI là một lớp trong OKELAS, không phải trung tâm. OKELAS không hoạt động như một trợ lý chat đơn thuần.',
        icon: 'tabler:message-off',
      },
      {
        title: 'Không phải phần mềm lưu trữ tài liệu',
        description:
          'Lưu trữ tài liệu chưa phải là quản lý tri thức. OKELAS kết nối tri thức với vận hành thực tế.',
        icon: 'tabler:folder-off',
      },
      {
        title: 'Không phải ERP và không thay thế ERP',
        description:
          'ERP ghi nhận giao dịch. OKELAS quản lý quy trình, bối cảnh, bằng chứng và tri thức xung quanh đó. OKELAS giúp doanh nghiệp chuẩn bị, hiểu và khai thác ERP tốt hơn.',
        icon: 'tabler:database-off',
      },
      {
        title: 'Không phải hệ thống enterprise cồng kềnh',
        description:
          'OKELAS được thiết kế cho doanh nghiệp vừa và nhỏ: bắt đầu từ một vấn đề cụ thể, rồi mở rộng dần.',
        icon: 'tabler:building-skyscraper',
      },
    ]}
  />

  <!-- Why AI Age -->
  <section id="why-ai" class="bg-gray-50 dark:bg-slate-900/50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-16 lg:py-20">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6 font-heading">
          Why This Matters More in the Age of AI
        </h2>
        <p class="text-lg text-muted mb-6">Các doanh nghiệp đang bắt đầu gặp một nghịch lý:</p>
        <blockquote
          class="border-l-4 border-accent pl-6 py-4 mb-8 bg-blue-50 dark:bg-blue-900/10 rounded-r-lg not-italic"
        >
          <p class="text-lg font-medium">
            AI có thể giúp một doanh nghiệp 50 người tạo ra lượng văn bản của một doanh nghiệp 500 người. Nhưng điều
            đó không có nghĩa là doanh nghiệp 50 người xử lý được khối lượng công việc của 500 người.
          </p>
        </blockquote>
        <p class="text-lg text-muted mb-4">
          Báo cáo, email, đề xuất và tài liệu được tạo ra nhanh hơn. Nhưng nếu quy trình, phân quyền, phê duyệt và
          bằng chứng vẫn rời rạc, nhiều thông tin hơn chỉ có nghĩa là có nhiều thứ hơn phải đọc, đối chiếu và tìm
          lại.
        </p>
        <p class="text-lg text-muted mb-4">
          Câu hỏi không còn là <em>"làm sao tạo thông tin nhanh hơn?"</em>. Câu hỏi bây giờ là <em
            >"doanh nghiệp có biến được thông tin thành quy trình, quyết định và hành động hay không?"</em
          >
        </p>
        <p class="text-lg text-muted">
          Vì vậy, AI không phải trung tâm của OKELAS. AI hoạt động <strong class="text-default"
            >bên trong bối cảnh của tổ chức</strong
          >: hiểu quy trình, tìm đúng bằng chứng, hỗ trợ workflow và để lại dấu vết có thể kiểm tra. Một câu trả lời
          tốt không chỉ cần đúng mà còn phải <strong class="text-default"
            >giải thích được, có bằng chứng và truy vết được</strong
          >.
        </p>
      </div>
    </div>
  </section>

  <!-- Assessment - 6 Pillars -->
  <Features2
    id="assessment"
    tagline="Diagnostic-Led Advisory"
    title="Assess First. Improve Immediately. Configure from Reality."
    subtitle="Mỗi doanh nghiệp bắt đầu từ một trạng thái vận hành khác nhau. OKELAS bắt đầu bằng đánh giá năng lực trên 6 trụ cột — mỗi bài vừa giúp cải thiện ngay, vừa làm nền tảng để cấu hình OKELAS đúng với doanh nghiệp."
    columns={2}
    items={[
      {
        title: '01 — Digitalization',
        description:
          'Quy trình và dữ liệu nào vẫn đang làm thủ công? Xác định chỗ số hóa mang lại hiệu quả kinh tế nhất.',
        icon: 'tabler:file-code-2',
        callToAction: { text: 'Bắt đầu đánh giá →', href: '/readiness/digitalization' },
      },
      {
        title: '02 — Workflow',
        description:
          'Việc đang đi qua ai và bị tắc ở đâu? Tìm điểm nghẽn, việc nhập liệu lặp lại và các khoảng trống phê duyệt.',
        icon: 'tabler:route-2',
        callToAction: { text: 'Bắt đầu đánh giá →', href: '/readiness/workflow' },
      },
      {
        title: '03 — Knowledge',
        description:
          'Tri thức đang nằm ở đâu và phụ thuộc vào ai? Giảm phụ thuộc vào cá nhân và file rời rạc.',
        icon: 'tabler:sitemap',
        callToAction: { text: 'Bắt đầu đánh giá →', href: '/readiness/knowledge' },
      },
      {
        title: '04 — ERP Readiness',
        description:
