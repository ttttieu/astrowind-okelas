---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'OKELAS — Organizational Knowledge Operating System',
  description: 'Bridge the gap between static knowledge and daily operations. Standardize processes, structure knowledge, and prepare for ERP & AI.',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Organizational Knowledge Operating System"
    actions={[
      {
        variant: 'primary',
        text: 'Assess Your Business Readiness',
        href: '/readiness',
        icon: 'tabler:clipboard-check',
      },
      { text: 'Why Before ERP & AI', href: '/why/why-before-erp' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'OKELAS Architecture Overview' }}
  >
    <Fragment slot="title">
      Your company is creating more information, <span class="text-accent dark:text-white">but not necessarily becoming more capable.</span>
    </Fragment>

    <Fragment slot="subtitle">
      AI helps a 50-person company generate documents like a 500-person enterprise. But documents alone don't build operational capability. OKELAS transforms static operational knowledge into executable workflows before you scale with ERP or AI.
    </Fragment>
  </Hero>

  <!-- SocialProof Widget ************ -->

 <SocialProof
    id="proof"
    classes={{ container: '!pb-14 md:!pb-20' }}
    items={[
      { value: '70%', label: 'ERP Projects Fail Without Clean Processes', icon: 'tabler:alert-triangle', color: 'text-amber-500' },
      { value: 'eQMS', label: 'Progressive Quality & Knowledge Framework', icon: 'tabler:certificate', color: 'text-emerald-500' },
      { value: 'AI-Ready', label: 'Structured Knowledge Graph Backend', icon: 'tabler:cpu', color: 'text-sky-500' },
    ]}
  />

  <!-- Features2 ************* -->

  <Features2
    id="readiness-gateway"
    tagline="Diagnostic-Led Advisory"
    title="Assess Your Organizational Readiness"
    subtitle="Before investing in expensive software implementations, evaluate your current operational maturity."
    items={[
      {
        title: 'ERP Readiness Audit',
        description: 'Check if your processes and data are sufficiently standardized to avoid high-cost ERP implementation failures.',
        icon: 'tabler:database-search',
        callToAction: { text: 'Audit ERP Readiness →', href: '/readiness/erp' },
      },
      {
        title: 'Digitalization Assessment',
        description: 'Distinguish between genuine operational digitalization and merely digitizing document chaos.',
        icon: 'tabler:file-code-2',
        callToAction: { text: 'Evaluate Digitalization →', href: '/readiness/digitalization' },
      },
      {
        title: 'AI Readiness Test',
        description: 'Determine if your internal domain data is clean and structured enough to power private AI Copilots.',
        icon: 'tabler:brain',
        callToAction: { text: 'Test AI Readiness →', href: '/readiness/ai' },
      },
      {
        title: 'Knowledge Infrastructure Check',
        description: 'Evaluate whether critical operational knowledge lives in employee heads or structured systems.',
        icon: 'tabler:sitemap',
        callToAction: { text: 'Check Knowledge Gap →', href: '/readiness/knowledge' },
      },
    ]}
  />

  <!-- Features Widget *************** -->

  <Features
    id="solutions"
    tagline="Our Core Offerings"
    title="The OKELAS Operating Framework"
    subtitle="A progressive approach to operational capability, moving from document standardization to AI-assisted workflows."
    items={[
      {
        title: 'Digitalize Operations',
        description: 'Convert scattered manuals and unspoken routines into clear, interactive digital workflows.',
        icon: 'tabler:transform',
      },
      {
        title: 'Standardize Processes',
        description: 'Establish clear SOPs, role assignments, and validation checkpoints across all departments.',
        icon: 'tabler:checkup-list',
      },
      {
        title: 'Progressive eQMS',
        description: 'Build audit-ready compliance and records management structured around your actual daily work.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'ERP Readiness Layer',
        description: 'Cleanse master data and validate operational logic before connecting heavy enterprise systems.',
        icon: 'tabler:building-factory-2',
      },
      {
        title: 'Knowledge & AI Copilot',
        description: 'Feed accurate, domain-specific organizational knowledge directly to context-aware AI assistants.',
        icon: 'tabler:robot',
      },
      {
        title: 'Workflow Automation',
        description: 'Eliminate manual handoffs and ensure complete compliance traceability automatically.',
        icon: 'tabler:route-2',
      },
    ]}
  />
  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Inside template"
    title="AstroWind's Blueprint: Fun Meets Functionality!"
    items={[
      {
        title: 'Built on top of Astro v7',
        description:
          'Benefiting from the performance and developer-friendly features of this modern static site generator.',
      },
      {
        title: 'Styled using Tailwind CSS v4',
        description:
          'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.',
      },
      {
        title: 'Cross-browser compatibility',
        description:
          'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Building on modern foundations</h3>
      Gain a competitive advantage by incorporating industry leading practices
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'High level of customization',
        description: `Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
      },
      {
        title: 'Multiple layout possibilities',
        description:
          'Explore various layout options to find the structure that best presents your content, enhancing user engagement and navigation.',
      },
      {
        title: 'Fully responsive design',
        description:
          "Ensure your website's optimal performance on various devices and screen sizes, providing a consistent and enjoyable user experience.",
      },
      {
        title: 'Integration of media',
        description:
          'Seamlessly incorporate images, videos, and multimedia elements that enhance your content and engage visitors effectively.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616674282942-2835e62d612e?auto=format&fit=crop&w=1600&q=80',
      alt: 'Printed website wireframes on a black table',
    }}
  >
    <Fragment slot="content">Ensure your online presence truly represents you.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Enhanced user engagement',
        description:
          'Captivate your audience with interactive elements, intuitive navigation, and visually appealing layouts, encouraging longer visits.',
      },
      {
        title: 'Continuous improvement',
        description:
          'Ensure your website stays aligned with the latest trends and technologies through regular updates and enhancements.',
      },
      {
        title: 'Time and resource efficiency',
        description:
          'Skip the time-consuming process of building a website from scratch and launch your online presence sooner with AstroWind.',
      },
      {
        title: 'Community support',
        description: `Join the growing AstroWind community for insights, resources, and assistance, ensuring you're never alone on your web development journey.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Astronauts Image',
    }}
  >
    <Fragment slot="content">Designed to foster growth and success.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

 <Steps
    title="How OKELAS Transforms Operational Knowledge into Capability"
    items={[
      {
        title: 'Phase 1: <span class="font-medium">Standardize Operations</span>',
        description: 'Extract tacit expert knowledge and document actual daily routines into unified, executable standards.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Phase 2: <span class="font-medium">Organize Knowledge</span>',
        description: 'Structure static documents into a dynamic Knowledge Graph linked directly to roles and workflows.',
        icon: 'tabler:topology-complex',
      },
      {
        title: 'Phase 3: <span class="font-medium">Digitize Records & Proof</span>',
        description: 'Automate real-time record capture for complete compliance, audit readiness, and quality assurance.',
        icon: 'tabler:report-analytics',
      },
      {
        title: 'Phase 4: <span class="font-medium">Scale with ERP & AI</span>',
        description: 'Connect structured operational data seamlessly into ERP systems or deploy internal AI Copilots with confidence.',
        icon: 'tabler:rocket',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=987&q=80',
      alt: 'OKELAS Operational Transformation Roadmap',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Most used widgets"
    subtitle="Provides frequently used components for building websites using Tailwind CSS v4"
    tagline="Components"
    items={[
      {
        title: 'Headers',
        description: "Ever tried driving without GPS? Boom! That's why websites need headers for direction.",
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Heros',
        description:
          "Picture a superhero landing – epic, right? That's the job of a Hero section, making grand entrances!",
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'Features',
        description:
          'Where websites strut their stuff and show off superpowers. No holding back on the bragging rights here!',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'Content',
        description:
          "Dive into the meat and potatoes of a site; without it, you'd just be window shopping. Content is king.",
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Call-to-Action',
        description:
          'That enthusiastic friend who\'s always urging, "Do it! Do it!"? Yeah, that\'s this button nudging you towards adventure.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'Pricing',
        description: 'Behold the dessert menu of the website world. Tempting choices await, can you resist?',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'Testimonial',
        description: 'Step into the gossip corner! Here, other visitors spill the beans and share the juicy details.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'Contact',
        description:
          'Like a digital mailbox, but faster! Drop a line, ask a question, or send a virtual high-five. Ding! Message in.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'Footers',
        description: "The footer's like the credits of a movie but sprinkled with easter eggs. Time to hunt!",
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Timeline Widget **************** -->

  <Timeline
    id="story"
    layout="alternate"
    tagline="Our story"
    title="One template, since 2022"
    subtitle="Started before Astro 1.0 shipped, shaped by every Astro release since, and by the people who kept sending pull requests."
    items={[
      {
        date: 'June 2022',
        title: 'A template for a framework still in beta',
        description:
          'AstroWind starts on Astro 1.0 beta with a handful of pages, a few widgets and one idea: a website can be fast, simple and good-looking at the same time.',
        icon: 'tabler:rocket',
      },
      {
        date: '2022',
        title: 'The most starred Astro theme, in its first year',
        description:
          'By December it is the most starred theme in the Astro ecosystem, a place it would hold year after year. The first pull requests from strangers arrive, and they keep coming.',
        icon: 'tabler:star-filled',
      },
      {
        date: '2022–2023',
        title: 'The busiest stretch',
        description:
          'Astro grows fast and the template grows with it: collections for content, better images, page transitions. The blog matures, the widgets double, the road to 1.0 begins, and more people than ever send pull requests.',
        icon: 'tabler:users-group',
      },
      {
        date: '2024',
        title: 'Polish',
        description:
          'Astro 4, and a year of small, careful improvements, most of them sent in by contributors: accessibility, tooling, ways to edit and ways to deploy. Three thousand stars by September.',
        icon: 'tabler:puzzle',
      },
      {
        date: '2025',
        title: 'Steady, and quieter',
        description:
          'Astro 5 and regular updates. Fewer commits, nothing broken, and the stars kept coming: five thousand by October.',
        icon: 'tabler:refresh',
      },
      {
        date: '2026',
        title: 'Astro 7 and Tailwind CSS 4',
        description:
          'Two framework majors in one year. The template gets a new generation of widgets, complete landing pages, a blog that finally reads like documentation, and a guide so coding assistants know their way around.',
        icon: 'tabler:sparkles',
      },
      {
        date: '2026',
        title: 'Release v1',
        description:
          'Four years after the first commit, the demo has no placeholders left: every page, every landing page and every post is real, and the template is ready for whatever comes next.',
        icon: 'tabler:circle-check-filled',
        highlight: true,
      },
      { icon: 'tabler:dots', ghost: true },
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />

  <!-- HighlightedPosts Widget ******* -->

  <BlogHighlightedPosts
    title="Find out more content in our Blog"
    postIds={[
      'get-started-website-with-astro-tailwind-css',
      'how-to-customize-astrowind-to-your-brand',
      'useful-resources-to-create-websites',
      'landing',
    ]}
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro v7 + Tailwind CSS v4.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faqs"
    title="Frequently Asked Questions"
    subtitle="The questions people ask before they clone the repository, answered briefly. For step-by-step tasks, the repository ships skills your AI coding assistant can follow."
    tagline="FAQs"
    schema
    items={[
      {
        title: 'What is AstroWind?',
        description:
          'A free, open-source template for Astro and Tailwind CSS: a static site with a header, footer, twenty-plus reusable widgets, a Markdown/MDX blog, dark mode, RTL support, image optimisation, SEO metadata and an RSS feed, ready to be customised and deployed anywhere static files are served.',
      },
      {
        title: 'What do I need to start?',
        description:
          'A current Node.js (the exact minimum is in <code>package.json</code>) and a terminal. Run <code>npm create astro@latest -- --template arthelokyo/astrowind</code>, then <code>npm run dev</code>. Site name, URL, metadata and blog options live in <code>src/config.yaml</code>; colours and fonts in <code>src/components/CustomStyles.astro</code>.',
      },
      {
        title: 'Can I use it for a site without a blog?',
        description:
          'Yes. Set <code>apps.blog.isEnabled: false</code> in <code>src/config.yaml</code> and the blog routes, the RSS feed and the post widgets disappear from the build. The rest of the template is unaffected.',
      },
      {
        title: 'How do I change colours, fonts and the logo?',
        description:
          'Colours are CSS variables in <code>src/components/CustomStyles.astro</code> (light and dark), fonts are configured in <code>astro.config.ts</code> through Astro’s Fonts API, and the logo is <code>src/components/Logo.astro</code>. The same variables also feed the shadcn/ui-compatible tokens, so shadcn-style components pick up your theme.',
      },
      {
        title: 'Does it work with an AI coding assistant?',
        description:
          'It is built for it. The repository includes <code>AGENTS.md</code> with the project conventions and a <code>.agents/skills/</code> folder with step-by-step guides for common tasks (disable the blog, set an Open Graph image, deploy under a base path, connect a CMS, deploy to Cloudflare…), so tools like Claude Code, Codex or Cursor can do them reliably.',
      },
      {
        title: 'Where can I deploy it and what does it cost?',
        description:
          'Anywhere that serves static files: Vercel, Netlify, Cloudflare, GitHub Pages, an nginx container (a Dockerfile is included) or your own server. The template is MIT licensed and free for personal and commercial projects.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    id="stats"
    countUp
    stats={[
      { title: 'GitHub stars', amount: '6K' },
      { title: 'Forks', amount: '1.7K' },
      { title: 'Ready-made widgets', amount: '34' },
      { title: 'Lighthouse score', amount: '100' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Readiness Assessment',
        href: '/readiness',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to turn organizational knowledge into operational capability?
    </Fragment>

    <Fragment slot="subtitle">
      Take our 3-minute diagnostic assessment to pinpoint your process gaps before your next ERP or AI milestone.
    </Fragment>
  </CallToAction>
</Layout>
