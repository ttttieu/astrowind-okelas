---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import { getArticlesByCategory } from '~/lib/insights';
import type { ImageMetadata } from 'astro';

const metadata = {
  title: 'Workflow — OKELAS Insights',
  description:
    'From digitized workflow to agentic workflow — a series on designing, optimizing, and applying AI to operational processes for manufacturing SMEs.',
};

const { grouped } = await getArticlesByCategory('en');
let workflowArticles = grouped.workflow || [];

// Import all EN workflow cover images from src/assets
const enCoverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/insights/*/wf*-00-og-cover-en.png',
  { eager: true }
);
const enCovers: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(enCoverGlob)) {
  const match = path.match(/\/insights\/([^/]+)\//);
  if (match) enCovers[match[1]] = mod.default;
}

// Sort by translationId — uses article.data (frontmatter), not article.id (filename format varies)
const articleOrder: Record<string, number> = {
  'workflow-pillar-manufacturing-sme': 0,              // PILLAR
  'article-5-1-workflow-still-slow': 1,
  'article-5-2-digitized-vs-optimized': 2,
  'article-5-3-approval-to-e2e': 3,
  'article-5-4-human-bottleneck': 4,
  'article-5-5-visibility-gap': 5,
  'article-5-6-automation-vs-intelligent': 6,
  'article-5-7-workflow-next-level': 7,
  'article-5-8-event-driven-workflow': 8,
  'article-5-9-request-approval-to-event-action': 9,
  'workflow-rule-human-decision': 10,
  'article-5-11-exception-handling-workflow': 11,
  'article-5-12-automation-ai-workflow': 12,
  'article-5-10-where-ai-fits-workflow': 13,
  'article-5-14-classification-routing-workflow': 14,
  'article-5-15-ai-evidence-human-decision': 15,
  'article-5-16-context-aware-workflow': 16,
  'article-5-17-separation-of-duties-workflow': 17,
  'article-5-18-delegating-steps-workflow': 18,
  'article-5-19-ai-agent-workflow': 19,
  'article-5-20-workflow-journey': 20,
};

// Sort articles by series order using translationId from frontmatter
workflowArticles.sort((a, b) => {
  const orderA = articleOrder[a.data.translationId] ?? 999;
  const orderB = articleOrder[b.data.translationId] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Workflow" />

  <Content
    content={`
      <p>Workflow is the foundation of operations — but most organizations are running it at a much lower level than they could. This series moves from foundational questions — why digitized workflow is still slow, why automation isn't enough — to the design principles behind workflow where AI participates as a fully governed participant.</p>

      <p class="mt-6">
        <strong>Start here — Pillar article:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/en/insights/workflow/workflow-for-manufacturing-companies" class="text-primary hover:underline">Workflow for Manufacturing Companies: From Approval to Operations With Context, Evidence and AI Assistance →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Quick self-assessment:</strong>
        <a href="/en/insights/workflow/workflow-maturity-journey" class="text-primary hover:underline ml-1">Where Is Your Business on the Workflow Journey? →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">All Workflow articles</h2>
      <ul class="space-y-6">
        {workflowArticles.map((article) => {
          const coverImg = enCovers[article.id];
          return (
          <li key={article.id} class="flex items-start gap-6 group">
            {coverImg && (
              <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                <Image
                  src={coverImg}
                  alt={article.data.title}
                  class="w-full h-auto block"
                />
              </div>
            )}
            <a
              href={`/en/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                {article.data.contentType && (
                  <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                    {article.data.contentType}
                  </span>
                )}
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Take the Digitalization Readiness Assessment',
        href: '/en/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Workflow Automation Solution',
        href: '/en/solutions/workflow-automation',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Where do your workflows stand today</Fragment>
    <Fragment slot="subtitle">
      Find out which workflow bottlenecks are process gaps versus capability gaps.
    </Fragment>
  </CallToAction>
</Layout>
