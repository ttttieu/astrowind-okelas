---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'ERP — OKELAS Insights',
  description:
    "Why ERP projects succeed or fail, and what \"ERP readiness\" concretely means before you sign a contract.",
};

const { grouped } = await getArticlesByCategory('en');
let erpArticles = grouped.erp || [];

// Define article order: pillar first, then 1.1 to 1.12
const articleOrder: Record<string, number> = {
  'why-erp-projects-fail': 0, // PILLAR
  'is-your-business-ready-for-erp': 1, // 1.1
  'process-standardization-before-erp': 2, // 1.2
  'erp-data-readiness': 3, // 1.3
  'erp-scope-creep': 4, // 1.4
  'erp-customization-risks': 5, // 1.5
  'erp-user-adoption': 6, // 1.6
  'accounting-readiness-erp': 7, // 1.7
  'erp-for-manufacturing-companies': 8, // 1.8
  'erp-still-using-excel': 9, // 1.9
  'erp-governance': 10, // 1.10
  'erp-implementation-vs-adoption': 11, // 1.11
  'how-to-use-erp-data': 12, // 1.12
};

// Sort articles by order
erpArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="ERP" />

  <Content
    content={`
      <p>ERP has a reputation problem, and it's mostly earned — a meaningful share of ERP projects run over budget, past deadline, or fail to deliver what was promised. This category looks at why that happens, what "ERP readiness" concretely means, and what to check before — and after — a contract gets signed.</p>

      <p class="mt-6">
        <strong>Start here — Pillar article:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/en/insights/erp/why-erp-projects-fail" class="text-primary hover:underline">Why ERP Projects Fail — and What the Software Cannot Fix →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Why OKELAS perspective:</strong>
        <a href="/en/why/why-before-erp" class="text-primary hover:underline ml-1">Why Before ERP — what the readiness research actually says →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/en/readiness/erp" class="text-primary hover:underline ml-1">Take the ERP Readiness Assessment →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 py-8 md:py-12">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">All ERP articles</h2>
      <ul class="space-y-4">
        {erpArticles.map((article) => (
          <li key={article.id} class="flex items-start gap-4 group">
            <a
              href={`/en/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
            </a>
            <div class="flex flex-wrap gap-2 justify-end">
              <span
                class:list={[
                  'px-2 py-1 rounded text-xs font-semibold whitespace-nowrap',
                  typeBadgeClass[article.data.contentType] ??
                    'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300',
                ]}
              >
                {article.data.contentType}
              </span>
              {article.data.funnelStage?.[0] && (
                <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                  {article.data.funnelStage[0]}
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'ERP Readiness Assessment',
        href: '/en/readiness/erp',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'ERP Readiness Solution',
        href: '/en/solutions/erp-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Is your organization ready for ERP?</Fragment>
    <Fragment slot="subtitle">
      The ERP Readiness Assessment evaluates processes, data, and governance — the factors that determine whether an ERP project delivers or struggles.
    </Fragment>
  </CallToAction>
</Layout>
