---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'Knowledge Management — OKELAS Insights',
  description:
    'What it actually takes to move knowledge out of people\'s heads and into something the organization can rely on, search, and hand to an AI system.',
};

const { grouped } = await getArticlesByCategory('en');
let kmArticles = grouped['knowledge-management'] || [];

// Define article order: pillar first, then 3.1 to 3.9
const articleOrder: Record<string, number> = {
  'knowledge-management-manufacturing': 0, // PILLAR
  'knowledge-loss-when-employees-leave': 1, // 3.1
  'why-sops-are-not-followed': 2, // 3.2
  'ai-document-explosion': 3, // 3.3
  'tacit-vs-explicit-knowledge': 4, // 3.4
  'excel-shadow-it': 5, // 3.5
  'cost-of-knowledge-loss': 6, // 3.6
  'dms-vs-knowledge-management': 7, // 3.7
  'knowledge-graph-for-business': 8, // 3.8
  'why-audit-preparation-takes-so-long': 9, // 3.9
};

// Sort articles by order
kmArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Knowledge Management" />

  <Content
    content={`
      <p>When an experienced employee leaves, most companies lose more than a headcount — they lose judgment calls that were never written down. This category is about what it actually takes to move knowledge out of people's heads and into something the organization can rely on, search, and hand to an AI system without losing what made it valuable in the first place.</p>

      <p class="mt-6">
        <strong>Start here — Pillar article:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/en/insights/knowledge-management/knowledge-management-manufacturing" class="text-primary hover:underline">From Individual Knowledge to Organizational Knowledge: A Manufacturing Challenge You Can't Avoid →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Why OKELAS perspective:</strong>
        <a href="/en/why/knowledge-as-infrastructure" class="text-primary hover:underline ml-1">Knowledge as Infrastructure — why we don't treat knowledge as a filing cabinet →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/en/readiness/knowledge-management" class="text-primary hover:underline ml-1">Take the Knowledge Readiness Assessment →</a>
      </p>

      <div class="mt-8">
        <p class="font-semibold mb-3">Topics we're covering here <span class="font-normal text-muted">(more added regularly):</span></p>
        <ul class="space-y-2 text-muted">
          <li>Organizational knowledge — what it is once you get specific about it</li>
          <li>Tacit → explicit knowledge — the conversion that most companies skip</li>
          <li>Knowledge sharing — why "put it on the shared drive" doesn't count</li>
          <li>Knowledge retention — the real cost of a key employee leaving</li>
          <li>Knowledge infrastructure — building for reuse, not just storage</li>
          <li>Knowledge management + AI — what an AI system needs from your knowledge to be useful</li>
        </ul>
      </div>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">All Knowledge Management articles</h2>
      <ul class="space-y-4">
        {kmArticles.map((article) => (
          <li key={article.id} class="flex items-start gap-4 group">
            <a
              href={`/en/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
            </a>
            {article.data.funnelStage?.[0] && (
              <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                {article.data.funnelStage[0]}
              </span>
            )}
          </li>
        ))}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Knowledge Readiness Assessment',
        href: '/en/readiness/knowledge-management',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Knowledge & Copilot',
        href: '/en/solutions/knowledge-copilot',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">How dependent is your organization on specific people?</Fragment>
    <Fragment slot="subtitle">
      The Knowledge Readiness Assessment helps identify where knowledge lives — and what happens if the people holding it leave.
    </Fragment>
  </CallToAction>
</Layout>
