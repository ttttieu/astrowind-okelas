---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Image } from 'astro:assets';
import { getArticlesByCategory } from '~/lib/insights';
import type { ImageMetadata } from 'astro';

const metadata = {
  title: 'AI — OKELAS Insights',
  description:
    "What separates AI that generates content from AI that an operations team can actually trust with a decision — readiness, agentic AI, Copilots, and organizational AI.",
};

const { grouped } = await getArticlesByCategory('en');
const aiArticles = grouped.ai || [];

// Import all EN AI cover images from src/assets (flat directory)
const enCoverGlob = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/insights/*-00-og-cover-en.png',
  { eager: true }
);
const enCovers: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(enCoverGlob)) {
  const match = path.match(/\/([a-z0-9]+)-00-og-cover-en\.png$/);
  if (match) enCovers[match[1]] = mod.default;
}

// Map EN article ID → cover image prefix (Pillar 2: AI Readiness)
const pillar2CoverPrefix: Record<string, string> = {
  'organizational-ai-readiness': 'aip',
  'ai-productivity-paradox': 'aipp',
  'ai-productivity-vs-organizational-intelligence': 'aiop',
  'rag-limitations-enterprise-ai': 'rag',
  'ai-readiness-checklist': 'rdy',
  'data-without-context-ai-problem': 'dwc',
  'ai-agents-for-business': 'agt',
  'evidence-based-ai': 'ebai',
  'ai-implementation-roadmap-manufacturing': 'rmp',
  'ai-compliance-iso-gmp-manufacturing': 'icg',
  'organizational-ai': 'oai',
};

// Map EN article ID → cover image prefix (Pillar 6: AI Control Layer)
const pillar6CoverPrefix: Record<string, string> = {
  'enterprise-ai-control-layer': 'acl',
  'ai-beyond-chatbot-agentic': 'agc',
  'frontier-ai-capabilities-business': 'agc',
  'agentic-ai-vs-ai-assistant': 'agc',
  'ai-autonomy-control-problem': 'agc',
  'ai-bypassing-restrictions-research': 'agt',
  'multi-agent-ai-system-risks': 'agv',
  'ai-transparency-audit-trail': 'agac',
  'ai-agent-cybersecurity-enterprise': 'agbr',
  'should-ai-agent-have-full-access': 'aid',
  'ai-agent-error-vs-chatbot-error': 'agc',
  'ai-authority-vs-intelligence': 'aaa',
  'least-privilege-ai-agent': 'aaa',
  'enterprise-ai-control-layer-architecture': 'acl',
  'what-is-kvm': 'aaa',
  'ai-reasoning-vs-organizational-truth': 'aaa',
  'ai-agent-authority-profile': 'aaa',
  'ai-employee-identity-authority-audit': 'aaa',
  'ai-safety-frontier-enterprise-lessons': 'aaa',
  'frontier-ai-safety-enterprise-ai-control': 'aaa',
  'kvm-enterprise-ai-control-layer': 'aaa',
};

// Pillar 2: AI Readiness series
const pillar2Order: Record<string, number> = {
  'organizational-ai-readiness': 0,
  'ai-productivity-paradox': 1,
  'ai-productivity-vs-organizational-intelligence': 2,
  'rag-limitations-enterprise-ai': 3,
  'ai-readiness-checklist': 4,
  'data-without-context-ai-problem': 5,
  'ai-agents-for-business': 6,
  'evidence-based-ai': 7,
  'ai-implementation-roadmap-manufacturing': 8,
  'ai-compliance-iso-gmp-manufacturing': 9,
  'organizational-ai': 10,
};

// Pillar 6: AI Control Layer series
const pillar6Order: Record<string, number> = {
  'enterprise-ai-control-layer': 0,
  'ai-beyond-chatbot-agentic': 1,
  'frontier-ai-capabilities-business': 2,
  'agentic-ai-vs-ai-assistant': 3,
  'ai-autonomy-control-problem': 4,
  'ai-bypassing-restrictions-research': 5,
  'multi-agent-ai-system-risks': 6,
  'ai-transparency-audit-trail': 7,
  'ai-agent-cybersecurity-enterprise': 8,
  'should-ai-agent-have-full-access': 9,
  'ai-agent-error-vs-chatbot-error': 10,
  'ai-authority-vs-intelligence': 11,
  'least-privilege-ai-agent': 12,
  'enterprise-ai-control-layer-architecture': 13,
  'what-is-kvm': 14,
  'ai-reasoning-vs-organizational-truth': 15,
  'ai-agent-authority-profile': 16,
  'ai-employee-identity-authority-audit': 17,
  'ai-safety-frontier-enterprise-lessons': 18,
  'frontier-ai-safety-enterprise-ai-control': 19,
  'kvm-enterprise-ai-control-layer': 20,
};

const pillar2Articles = aiArticles
  .filter((article) => article.id in pillar2Order)
  .sort((a, b) => (pillar2Order[a.id] ?? 999) - (pillar2Order[b.id] ?? 999));

const pillar6Articles = aiArticles
  .filter((article) => article.id in pillar6Order)
  .sort((a, b) => (pillar6Order[a.id] ?? 999) - (pillar6Order[b.id] ?? 999));

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="AI" />

  <Content
    content={`
      <p>AI can now help a small team produce output that used to take a much larger one. But that's not the same as the organization becoming more capable — and for a lot of businesses, the gap between "we use AI" and "AI is actually useful in daily operations" is bigger than it looks. This section covers two series: readiness (the conditions that determine whether AI is actually useful) and AI control (when AI agents start acting, not just answering).</p>

      <p class="mt-6">
        <strong>Series 1 — AI Readiness:</strong>
        <a href="/en/insights/ai/organizational-ai-readiness" class="text-primary hover:underline ml-1">Why AI Alone Won't Make Your Organization More Intelligent →</a>
      </p>

      <p class="mt-3">
        <strong>Series 2 — AI Control Layer:</strong>
        <a href="/en/insights/ai/enterprise-ai-control-layer" class="text-primary hover:underline ml-1">What Should AI Be Allowed to Do? Why Enterprise AI Needs a Control Layer →</a>
      </p>

      <p class="mt-5">
        <strong>Assess it:</strong>
        <a href="/en/readiness/ai" class="text-primary hover:underline ml-1">Take the AI Readiness Assessment →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Series 1: AI Readiness</h2>
        <p class="text-muted mb-6">The conditions that determine whether AI is actually useful in operations — or just fast at generating output.</p>
        <ul class="space-y-6">
          {pillar2Articles.map((article) => {
            const prefix = pillar2CoverPrefix[article.id];
            const coverImg = prefix ? enCovers[prefix] : undefined;
            return (
              <li key={article.id} class="flex items-start gap-6 group">
                {coverImg && (
                  <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                    <Image
                      src={coverImg}
                      alt={article.data.title}
                      class="w-full h-auto block"
                    />
                  </div>
                )}
                <a
                  href={`/en/insights/${article.data.category}/${article.id}`}
                  class="flex-1 hover:underline"
                >
                  <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                    {article.data.title}
                  </div>
                  <div class="flex flex-wrap gap-2 mt-1">
                    {article.data.contentType && (
                      <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                        {article.data.contentType}
                      </span>
                    )}
                    {article.data.funnelStage?.[0] && (
                      <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                        {article.data.funnelStage[0]}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <div class="mt-12">
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Series 2: AI Control Layer</h2>
        <p class="text-muted mb-6">When AI agents start acting instead of just answering — who controls them, within what scope, and how.</p>
        <ul class="space-y-6">
          {pillar6Articles.map((article) => {
            const prefix = pillar6CoverPrefix[article.id];
            const coverImg = prefix ? enCovers[prefix] : undefined;
            return (
              <li key={article.id} class="flex items-start gap-6 group">
                {coverImg && (
                  <div class="flex-shrink-0 w-60 rounded overflow-hidden">
                    <Image
                      src={coverImg}
                      alt={article.data.title}
                      class="w-full h-auto block"
                    />
                  </div>
                )}
                <a
                  href={`/en/insights/${article.data.category}/${article.id}`}
                  class="flex-1 hover:underline"
                >
                  <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                    {article.data.title}
                  </div>
                  <div class="flex flex-wrap gap-2 mt-1">
                    {article.data.contentType && (
                      <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                        {article.data.contentType}
                      </span>
                    )}
                    {article.data.funnelStage?.[0] && (
                      <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                        {article.data.funnelStage[0]}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'AI Readiness Assessment',
        href: '/en/readiness/ai',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'AI Readiness Solution',
        href: '/en/solutions/ai-readiness',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Is your organization ready for AI?</Fragment>
    <Fragment slot="subtitle">
      The AI Readiness Assessment evaluates the six conditions that determine whether AI can deliver real operational value — or just generate output faster.
    </Fragment>
  </CallToAction>
</Layout>
