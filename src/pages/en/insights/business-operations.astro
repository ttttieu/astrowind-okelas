---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'Digitalization — OKELAS Insights',
  description:
    'From document digitization to digital operations — a series on what real digitalization means for manufacturing SMEs, the stages, the roadmap, and the traps to avoid.',
};

const { grouped } = await getArticlesByCategory('en');
let digitalizationArticles = grouped['business-operations'] || [];

// Sort by translationId — uses article.data (frontmatter), not article.id (filename format varies)
const articleOrder: Record<string, number> = {
  'biz-ops-pillar-digital-transformation': 0,     // PILLAR
  'biz-ops-digitalization-stages': 1,              // 4.1
  'biz-ops-software-not-digitalization': 2,        // 4.2 (VI-only, no EN)
  'biz-ops-paperless-vs-digital': 3,               // 4.3
  'biz-ops-dms-eqms-knowledge-os': 4,              // 4.4
  'biz-ops-iso-gmp-records-management': 5,         // 4.5
  'biz-ops-cost-of-not-digitalizing': 6,           // 4.6
  'biz-ops-digital-transformation-failure': 7,     // 4.7
  'biz-ops-progressive-eqms-implementation': 8,   // 4.8
};

// Sort articles by series order using translationId from frontmatter
digitalizationArticles.sort((a, b) => {
  const orderA = articleOrder[a.data.translationId] ?? 999;
  const orderB = articleOrder[b.data.translationId] ?? 999;
  return orderA - orderB;
});
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Digitalization" />

  <Content
    content={`
      <p>Digitalization isn't about buying software — it's about changing how your organization captures, shares, and uses information in operations. This series moves from foundational questions — what digitalization actually means, why more software isn't the answer — to a concrete step-by-step roadmap: DMS, eQMS, Knowledge OS, and a progressive approach that fits manufacturing SMEs.</p>

      <p class="mt-6">
        <strong>Start here — Pillar article:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/en/insights/business-operations/digital-transformation-manufacturing-sme" class="text-primary hover:underline">Digital Transformation for Manufacturing SMEs: What It Really Means →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Quick self-assessment:</strong>
        <a href="/en/insights/business-operations/digital-maturity-levels" class="text-primary hover:underline ml-1">The 5 Stages of Business Digitalization: Where Are You? →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/en/readiness/digitalization" class="text-primary hover:underline ml-1">Take the Digitalization Readiness Assessment →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">All Digitalization articles</h2>
      <ul class="space-y-4">
        {digitalizationArticles.map((article) => (
          <li key={article.id} class="flex items-start gap-4 group">
            <a
              href={`/en/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
            </a>
            {article.data.funnelStage?.[0] && (
              <span class="px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 whitespace-nowrap">
                {article.data.funnelStage[0]}
              </span>
            )}
          </li>
        ))}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Digitalization Readiness Assessment',
        href: '/en/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Digitalize Operations',
        href: '/en/solutions/digitalize-operations',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">What stage of digitalization is your organization at?</Fragment>
    <Fragment slot="subtitle">
      The Digitalization Readiness Assessment evaluates your digital maturity level — returning specific results and the most meaningful next step for your business.
    </Fragment>
  </CallToAction>
</Layout>
