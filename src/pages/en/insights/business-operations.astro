---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getArticlesByCategory } from '~/lib/insights';

const metadata = {
  title: 'Business & Operations — OKELAS Insights',
  description:
    'Digitalization, process standardization, workflow and the operational habits that determine whether any system actually works once in place.',
};

const { grouped } = await getArticlesByCategory('en');
let bizOpsArticles = grouped['business-operations'] || [];

// Define article order: 1 pillar + 9 articles (4.1 to 4.9)
const articleOrder: Record<string, number> = {
  'digital-transformation-manufacturing-sme': 0, // PILLAR 1
  'digital-maturity-levels': 1, // 4.1
  'paperless-vs-digital-transformation': 2, // 4.2
  'software-tools-not-digitalization': 3, // 4.3
  'dms-eqms-knowledge-os-roadmap': 4, // 4.4
  'iso-gmp-document-management-digitalization': 5, // 4.5
  'progressive-eqms-implementation': 6, // 4.6
  'cost-of-not-digitalizing': 7, // 4.7
  'digital-transformation-project-failure': 8, // 4.8
  'next-step-digitalization-roi': 9, // 4.9
};

// Sort articles by order
bizOpsArticles.sort((a, b) => {
  const orderA = articleOrder[a.id] ?? 999;
  const orderB = articleOrder[b.id] ?? 999;
  return orderA - orderB;
});

// Badge colors
const typeBadgeClass: Record<string, string> = {
  Opening: 'bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200',
  Analysis: 'bg-violet-100 text-violet-800 dark:bg-violet-900 dark:text-violet-200',
  'Case & Evidence': 'bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200',
  Pillar: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Insights" title="Business & Operations" />

  <Content
    content={`
      <p>Most operational problems don't announce themselves as "we need to digitalize" or "we need better workflows." They show up as a supervisor doing the same fix for the third time this month, or a process that worked fine at 50 people and is starting to break at 150. This category covers digitalization, process standardization, workflow design, and the operational habits that determine whether any system — ERP, AI, or otherwise — actually works once it's in place.</p>

      <p class="mt-6">
        <strong>Start here — Pillar articles:</strong>
      </p>
      <ul class="mt-2 space-y-1">
        <li><a href="/en/insights/business-operations/digital-transformation-manufacturing-sme" class="text-primary hover:underline">Digital Transformation for Manufacturing SMEs — What It Actually Means →</a></li>
      </ul>

      <p class="mt-5">
        <strong>Why OKELAS perspective:</strong>
        <a href="/en/why/documents-to-operations" class="text-primary hover:underline ml-1">From Documents to Operations →</a>
      </p>

      <p class="mt-3">
        <strong>Assess it:</strong>
        <a href="/en/readiness/digitalization" class="text-primary hover:underline ml-1">Take the Digitalization Readiness Assessment →</a>
      </p>
    `}
  />

  <div class="relative not-prose scroll-mt-[72px]">
    <div class="relative mx-auto px-4 sm:px-6 py-8 md:py-12" style="max-width: 900.5px;">
      <div>
        <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">All Business & Operations articles</h2>
      <ul class="space-y-4">
        {bizOpsArticles.map((article) => {
          const coverImages: Record<string, string> = {
            'digital-transformation-manufacturing-sme': 'dt-01b-og-cover-en.png',
            'digital-maturity-levels': 'lv-04-og-cover-en.png',
            'paperless-vs-digital-transformation': 'pl-04-og-cover-en.png',
            'software-tools-not-digitalization': 'sw-04-og-cover-en.png',
            'dms-eqms-knowledge-os-roadmap': 'rm-05-og-cover-en.png',
            'iso-gmp-document-management-digitalization': 'iso-05-og-cover-en.png',
            'progressive-eqms-implementation': 'pe-05-og-cover-en.png',
            'cost-of-not-digitalizing': 'cn-05-og-cover-en.png',
            'digital-transformation-project-failure': 'dp-06-og-cover-en.png',
            'next-step-digitalization-roi': 'nx-05-og-cover-en.png',
          };
          const imageName = coverImages[article.id] || '';
          const coverImagePath = `/assets/images/insights/${article.id}/${imageName}`;

          return (
          <li key={article.id} class="flex items-start gap-6 group">
            <div class="flex-shrink-0 w-60 h-20 overflow-hidden rounded bg-gray-200">
              <img
                src={coverImagePath}
                alt={article.data.title}
                class="w-full h-full object-cover"
              />
            </div>
            <a
              href={`/en/insights/${article.data.category}/${article.id}`}
              class="flex-1 hover:underline"
            >
              <div class="font-medium text-slate-900 dark:text-white group-hover:text-primary transition-colors">
                {article.data.title}
              </div>
              <div class="flex flex-wrap gap-2 mt-1">
                <span class="text-xs bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 px-2 py-0.5 rounded">
                  {article.data.category}
                </span>
                {article.data.funnelStage?.[0] && (
                  <span class="text-xs bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400 px-2 py-0.5 rounded">
                    {article.data.funnelStage[0]}
                  </span>
                )}
              </div>
            </a>
          </li>
        );
        })}
      </ul>
      </div>
    </div>
  </div>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Digitalization Readiness Assessment',
        href: '/en/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
      {
        variant: 'secondary',
        text: 'Digitalize Operations',
        href: '/en/solutions/digitalize-operations',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Where is your operation right now?</Fragment>
    <Fragment slot="subtitle">
      Take the assessment to understand where you stand and what the next meaningful step looks like for your business.
    </Fragment>
  </CallToAction>
</Layout>
