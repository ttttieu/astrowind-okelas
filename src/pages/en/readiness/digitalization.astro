---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: "Digitalization Readiness Assessment - OKELAS",
  description: "Evaluate your organization's digital maturity across five stages.",
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Readiness Assessment"
    title="Digitalization Readiness"
    subtitle="Understand your digital maturity stage and identify the most meaningful next step"
  />

  <Content
    content={`
      <p>The Digitalization Readiness Assessment evaluates your organization's digital maturity across five distinct stages, helping you understand where you stand and what your most impactful next move should be.</p>

      <p class="mt-4">The assessment will identify:</p>
      <ul class="mt-3 space-y-2">
        <li>✓ Your current digitalization maturity stage</li>
        <li>✓ Key strengths and critical gaps</li>
        <li>✓ Hidden risks and untapped opportunities</li>
        <li>✓ A prioritized roadmap for your next steps</li>
      </ul>

      <p class="mt-6"><strong>Start your assessment today to understand your position and path forward.</strong></p>
    `}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get Started',
        href: '/en/contact',
        icon: 'tabler:mail',
      },
      {
        variant: 'secondary',
        text: 'Learn More',
        href: '/en/solutions/digitalize-operations',
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Where are you in digitalization?</Fragment>
    <Fragment slot="subtitle">
      Evaluate your digital maturity and identify the most appropriate next step for your organization.
    </Fragment>
  </CallToAction>
</Layout>
