---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import AssessmentForm from '~/components/widgets/AssessmentForm.astro';

const metadata = {
  title: "Digitalization Readiness Assessment - OKELAS",
  description: "Evaluate your organization's digital maturity across five stages.",
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Readiness Assessment"
    title="Digitalization Readiness"
    subtitle="Understand your digital maturity stage and identify the most meaningful next step"
  />

  <AssessmentForm assessmentId="digitalization_level" language="en" />
</Layout>
