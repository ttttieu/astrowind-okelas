---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Progressive eQMS — OKELAS',
  description:
    'Xây dựng hệ thống compliance sẵn sàng cho audit, cấu trúc xoay quanh công việc hàng ngày của bạn. Bắt đầu từ chỗ cần gấp nhất, rồi mở rộng dần dần.',
};
---

<Layout metadata={metadata} translationId="progressive-eqms">
  <HeroText
    tagline="Giải Pháp"
    title="Progressive eQMS"
    subtitle="Chuẩn bị audit không nên ngốn hàng tuần thời gian của đội quality mỗi chu kỳ."
  />

  <Features3
    columns={1}
    items={[
      {
        title: 'Vấn đề',
        description:
          'Với các doanh nghiệp sản xuất chịu áp lực ISO hoặc GMP, việc chuẩn bị audit có thể ngốn hàng tuần thời gian của đội quality — chạy đi xin từng chữ ký, đối chiếu sổ ghi chép giấy, và dựng lại xem điều gì đã xảy ra từ trí nhớ khi một hồ sơ bị thất lạc.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Vì sao nó xảy ra',
        description:
          'Một hệ thống eQMS "đầy đủ" thường được định vị như một dự án triển khai kiểu tất-cả-hoặc-không-gì-cả — vừa tốn kém, vừa khó biện minh nhanh với một doanh nghiệp SME. Vì vậy công việc compliance vẫn cứ làm thủ công, bởi phương án thay thế trông giống như một dự án phần mềm kéo dài nhiều năm.',
        icon: 'tabler:zoom-question',
      },
      {
        title: 'Cách OKELAS tiếp cận',
        description:
          'OKELAS xây dựng hệ thống compliance và quản lý hồ sơ sẵn sàng cho audit, được cấu trúc xoay quanh chính công việc hàng ngày của bạn — bắt đầu từ chỗ đang cần gấp nhất (hồ sơ số, một điều khoản ISO cụ thể, một quy trình phê duyệt), rồi mở rộng dần dần tới một hệ thống tri thức vận hành được kết nối đầy đủ. Không có yêu cầu phải mua trọn bộ hệ thống trước khi kịp chứng minh mắt xích đầu tiên đã hoạt động.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Tự kiểm tra nhanh',
        description:
          'Lần audit gần nhất của bạn là khi nào, và thời gian chuẩn bị chiếm bao nhiêu giờ so với chính buổi audit đó?',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Thực Hiện Đánh Giá Readiness Số Hóa',
        href: '/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Bước Tiếp Theo</Fragment>
    <Fragment slot="subtitle">
      Tìm hiểu mức độ sẵn sàng của vận hành bạn cho hồ sơ số và các workflow compliance.
    </Fragment>
  </CallToAction>
</Layout>
