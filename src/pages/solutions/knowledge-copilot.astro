---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Tri thức & AI Copilot — OKELAS',
  description:
    'Khi một vận hành viên lâu năm hoặc một nhân sự gắn bó lâu dài nghỉ việc, doanh nghiệp thường không chỉ mất đi một con người — mà mất đi nhiều năm phán đoán chưa từng được viết ra. OKELAS cấu trúc hóa những gì người giỏi nhất của bạn biết thành thứ bền vững, tra cứu được, và dùng được cho cả con người lẫn AI.',
};
---

<Layout metadata={metadata} translationId="knowledge-copilot">
  <HeroText
    tagline="Giải Pháp"
    title="Tri thức & AI Copilot"
    subtitle="Khi một nhân viên giàu kinh nghiệm nghỉ việc, doanh nghiệp thường không chỉ mất đi một con người — mà mất đi nhiều năm những phán đoán chưa từng được ghi lại."
  />

  <Features3
    columns={1}
    items={[
      {
        title: 'Vấn đề',
        description:
          'Khi một vận hành viên lâu năm hoặc một nhân sự gắn bó lâu dài nghỉ việc, doanh nghiệp thường không chỉ mất đi một con người — mà mất đi nhiều năm phán đoán chưa từng được viết ra ở đâu cả: nên tin nhà cung cấp nào trong tình huống gấp, đường tắt nào là an toàn và đường tắt nào thì không. Ở một hướng khác, các trợ lý AI có thể trả lời rất trôi chảy nhưng vẫn sai ở những chi tiết cụ thể của doanh nghiệp bạn, bởi vì chúng chưa bao giờ được cung cấp context thực sự về cách doanh nghiệp bạn vận hành.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Vì sao nó xảy ra',
        description:
          'Phần lớn những gì một nhân viên giàu kinh nghiệm biết chưa từng được ghi lại, đơn giản vì trước giờ không cần thiết phải làm vậy — nó tồn tại trong đầu họ và trong thói quen làm việc hàng ngày. Và phần lớn các dự án triển khai AI chỉ cho mô hình ăn những chỉ dẫn chung chung hoặc một đống tài liệu chưa được cấu trúc, chứ không phải một bức tranh có cấu trúc, cập nhật, về cách tổ chức thực sự đang vận hành.',
        icon: 'tabler:zoom-question',
      },
      {
        title: 'Cách OKELAS tiếp cận',
        description:
          'OKELAS đưa tri thức tổ chức chính xác, đặc thù theo từng lĩnh vực, trực tiếp vào các trợ lý AI có nhận biết context — cấu trúc hóa những gì người giỏi nhất của bạn biết thành thứ bền vững, tra cứu được, và dùng được cho cả con người lẫn AI, với bằng chứng đứng sau mỗi câu trả lời chứ không phải một lời đoán nghe có vẻ hợp lý.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Tự kiểm tra nhanh',
        description:
          'Hãy nêu tên một quy trình mà nếu người giàu kinh nghiệm nhất của bạn không thể liên lạc được trong một tuần, doanh nghiệp sẽ thực sự gặp khó khăn. Tri thức đó, hôm nay, đã được ghi lại ở đâu chưa?',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Thực Hiện Đánh Giá Readiness Tri Thức',
        href: '/readiness/knowledge',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Bước Tiếp Theo</Fragment>
    <Fragment slot="subtitle">
      Tìm hiểu bao nhiêu tri thức quan trọng tồn tại trong đầu nhân viên versus trong các hệ thống có cấu trúc.
    </Fragment>
  </CallToAction>
</Layout>
