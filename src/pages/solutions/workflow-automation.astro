---
// NOTE (internal): Nav label is "Workflow Automation" but this page content uses
// "Intelligent Workflow" -- consistent with the homepage offering card rename.
// The nav label in src/navigation.ts still reads "Workflow Automation" and needs
// a separate decision before changing (it may affect URL slug references elsewhere).
// FLAG: confirm nav label alignment before next deploy.

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Intelligent Workflow — OKELAS',
  description:
    'Workflow thì đã có sẵn rồi. OKELAS giúp các workflow đã thiết lập trở nên nhanh hơn, linh hoạt hơn và có năng lực hơn bằng cách kết nối process, tri thức, bằng chứng và AI với nhau.',
};
---

<Layout metadata={metadata} translationId="workflow-automation">
  <HeroText
    tagline="Giải Pháp"
    title="Intelligent Workflow"
    subtitle="Workflow thì đã có sẵn rồi. Vấn đề là nó chậm, thủ công, và chạm trần khi doanh nghiệp lớn lên."
  />

  <Features3
    columns={1}
    items={[
      {
        title: 'Vấn đề',
        description:
          'Phê duyệt vẫn diễn ra, công việc vẫn được chuyển tiếp, hồ sơ vẫn được lưu trữ. Nhưng mọi thứ chậm — bàn giao thủ công, phải có người nhớ để theo dõi tiếp, và chính cái workflow từng chạy tốt khi doanh nghiệp có 50 nhân sự bắt đầu "kêu cót két" khi lên tới 150.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Vì sao nó xảy ra',
        description:
          'Một workflow chỉ đơn thuần chuyển công việc từ bước này sang bước khác, mà không có bất kỳ kết nối nào với tri thức, bằng chứng hay bối cảnh đứng sau những công việc đó, sẽ sớm chạm trần. Nó có thể chạy nhanh hơn, nhưng không thể "thông minh hơn" — mọi ngoại lệ vẫn cần một con người dừng lại để tìm hướng xử lý.',
        icon: 'tabler:zoom-question',
      },
      {
        title: 'Cách OKELAS tiếp cận',
        description:
          'OKELAS giúp các workflow đã thiết lập trở nên nhanh hơn, linh hoạt hơn và có năng lực hơn bằng cách kết nối process, tri thức, bằng chứng và AI với nhau — để một workflow không chỉ đơn giản là đẩy công việc đi tiếp, mà còn mang theo đủ context cần thiết để xử lý những ngoại lệ thường gặp mà không cần đẩy lên cấp cao mỗi lần.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Tự kiểm tra nhanh',
        description:
          'Trong workflow bận rộn nhất hàng tuần của bạn, có bao nhiêu bước tồn tại chỉ để một người "kiểm tra xem có ổn để tiếp tục không" — và trong số đó, bao nhiêu lần câu trả lời thực ra luôn là có?',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Thực Hiện Đánh Giá Readiness Số Hóa',
        href: '/readiness/digitalization',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Bước Tiếp Theo</Fragment>
    <Fragment slot="subtitle">
      Tìm hiểu những tắc nghẽn workflow nào là lỗi process versus lỗi năng lực.
    </Fragment>
  </CallToAction>
</Layout>
