---
// NOTE (internal): This page and the "ERP Readiness" entry under the Readiness menu
// intentionally point to the same assessment (/readiness/erp). One is the service/approach
// framing for Solutions visitors; the other is the direct diagnostic entry point.
// This overlap is by design -- do not merge or redirect.

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'ERP Readiness — OKELAS',
  description:
    'Các dự án ERP nổi tiếng với việc vượt ngân sách và trễ tiến độ. OKELAS xác thực lại logic vận hành và làm sạch master data trước khi bạn kết nối một hệ thống enterprise nặng.',
};
---

<Layout metadata={metadata} translationId="erp-readiness">
  <HeroText
    tagline="Giải Pháp"
    title="ERP Readiness"
    subtitle="Liệu chuyện này có biến thành một mớ hỗn độn tốn kém và gây xáo trộn? Đó là một nỗi lo chính đáng — và cũng là một nỗi lo có thể giải quyết được."
  />

  <Features3
    columns={1}
    items={[
      {
        title: 'Vấn đề',
        description:
          'Ban lãnh đạo khi cân nhắc ERP thực ra thường đang tự hỏi một câu hẹp hơn, chỉ là không nói thẳng ra: "Liệu chuyện này có biến thành một mớ hỗn độn tốn kém và gây xáo trộn không?" Đó là một nỗi lo chính đáng — các dự án triển khai ERP vốn nổi tiếng với việc vượt ngân sách và trễ tiến độ.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Vì sao nó xảy ra',
        description:
          'Nguyên nhân gốc rễ được nhắc tới nhất quán nhất trong các nghiên cứu ngành ERP không phải là phần mềm — mà là quy trình chưa được chuẩn hóa và dữ liệu chưa sạch khi đưa vào hệ thống mới. Một nền tảng ERP sẽ tự động hóa bất kỳ quy trình nào bạn đưa vào nó — kể cả một quy trình đang có vấn đề.',
        icon: 'tabler:zoom-question',
      },
      {
        title: 'Cách OKELAS tiếp cận',
        description:
          'OKELAS xác thực lại logic vận hành và làm sạch master data trước khi bạn kết nối một hệ thống enterprise nặng vào đó — đưa ra ánh sáng những lỗ hổng quy trình và vấn đề dữ liệu mà nếu không, sẽ chỉ lộ ra giữa chừng quá trình triển khai, khi việc sửa chúng tốn kém hơn rất nhiều. Đây không phải là thay thế cho nhà cung cấp ERP hay đối tác triển khai của bạn — đây là công việc readiness giúp cho công việc của họ thành công.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Tự kiểm tra nhanh',
        description:
          'Ngay lúc này, bạn có thể đưa ra một câu trả lời duy nhất, thống nhất cho câu hỏi "chúng ta đang có bao nhiêu SKU", từ một nguồn duy nhất, mà không cần gọi điện hỏi ai không?',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Thực Hiện Đánh Giá Readiness ERP',
        href: '/readiness/erp',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Bước Tiếp Theo</Fragment>
    <Fragment slot="subtitle">
      Xác định chính xác lỗ hổng quy trình và dữ liệu của bạn trước khi cam kết cho dự án ERP.
    </Fragment>
  </CallToAction>
</Layout>
