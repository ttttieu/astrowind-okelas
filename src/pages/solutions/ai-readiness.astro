---
// NOTE (internal): This page and the "AI Readiness" entry under the Readiness menu
// intentionally point to the same assessment (/readiness/ai). One is the service/approach
// framing for Solutions visitors; the other is the direct diagnostic entry point.
// This overlap is by design -- do not merge or redirect.

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AI Readiness — OKELAS',
  description:
    'Nhiều doanh nghiệp đã có sẵn công cụ AI. Ít doanh nghiệp hơn hẳn có thể tự tin nói tổ chức họ thực sự sẵn sàng AI hữu ích trong vận hành hàng ngày. OKELAS xây dựng nền tảng tri thức mà AI Copilot cần trước triển khai.',
};
---

<Layout metadata={metadata} translationId="ai-readiness">
  <HeroText
    tagline="Giải Pháp"
    title="AI Readiness"
    subtitle="Có sẵn công cụ AI trong tay không đồng nghĩa với việc đã sẵn sàng để AI thực sự hữu ích trong vận hành hàng ngày."
  />

  <Features3
    columns={1}
    items={[
      {
        title: 'Vấn đề',
        description:
          'Nhiều doanh nghiệp đã có sẵn công cụ AI để dùng. Nhưng ít doanh nghiệp hơn hẳn có thể tự tin nói rằng tổ chức mình thực sự sẵn sàng để AI hữu ích trong vận hành hàng ngày — công cụ thì có, nhưng câu trả lời nó đưa ra lại không neo vào cách doanh nghiệp thực sự vận hành.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Vì sao nó xảy ra',
        description:
          'AI readiness thường bị hiểu nhầm chỉ là data readiness. Nhưng một hệ thống AI còn cần đến organizational context — sự rõ ràng về quy trình, tri thức đã được cấu trúc, và cơ chế quản trị — để chuyển từ việc tạo ra văn bản nghe có vẻ hợp lý sang việc tạo ra thứ mà một đội vận hành thực sự có thể hành động và tin tưởng được.',
        icon: 'tabler:zoom-question',
      },
      {
        title: 'Cách OKELAS tiếp cận',
        description:
          'OKELAS đánh giá và xây dựng nền tảng tri thức cùng cơ chế quản trị mà một AI Copilot cần có trước khi triển khai — để mỗi câu trả lời đi kèm với ngữ cảnh và bằng chứng, chứ không chỉ là ngôn ngữ trôi chảy. Công việc nền tảng này cũng chính là căn cứ để xác định một sáng kiến AI nên bắt đầu ngay bây giờ, hay nên chờ xử lý xong một số lỗ hổng cụ thể trước đã.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Tự kiểm tra nhanh',
        description:
          'Nếu ngày mai trợ lý AI của bạn đưa ra một câu trả lời sai nhưng nghe rất chắc chắn về chính hoạt động vận hành của doanh nghiệp bạn, liệu có ai phát hiện ra điều đó trước khi một quyết định được đưa ra dựa trên câu trả lời ấy không?',
        icon: 'tabler:checkbox',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Thực Hiện Đánh Giá Readiness AI',
        href: '/readiness/ai',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Bước Tiếp Theo</Fragment>
    <Fragment slot="subtitle">
      Tìm hiểu tổ chức bạn đã sẵn sàng cho AI hay chưa — và cần xây dựng cái gì trước tiên nếu chưa.
    </Fragment>
  </CallToAction>
</Layout>
