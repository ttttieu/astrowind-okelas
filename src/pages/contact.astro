---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Talk to OKELAS — Contact Advisory',
  description:
    'Most conversations start with a question, not a commitment: "Are we actually ready for this?" Start with the relevant readiness assessment, or tell us the problem you\'re seeing.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Company"
    title="Talk to OKELAS"
    subtitle="Most conversations with us start with a question, not a commitment: "Are we actually ready for this?""
  />

  <ContactUs
    id="form"
    title="Start a conversation"
    subtitle="If you already know roughly where the gap is, the fastest way to start is the relevant readiness assessment — it takes about three minutes and gives you something useful whether or not you talk to us afterward. If you're not sure where to start, tell us the problem you're seeing on the floor or in the numbers, not the solution you think you need — that's usually the more useful starting point for us too."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
      },
    ]}
    textarea={{
      label: 'What problem are you seeing?',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to the collection of your contact information for the purpose of this enquiry.',
    }}
    description="We typically respond within one business day."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Readiness Assessment',
        href: '/readiness',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Or start with a self-assessment</Fragment>
    <Fragment slot="subtitle">
      Three minutes. No commitment. Useful output regardless of what comes next.
    </Fragment>
  </CallToAction>
</Layout>
