---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactForm from '~/components/widgets/ContactForm.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Liên Hệ OKELAS — Tư Vấn',
  description:
    'Hầu hết cuộc trò chuyện bắt đầu bằng một câu hỏi, không phải cam kết: "Chúng tôi có thực sự sẵn sàng không?" Bắt đầu bằng đánh giá readiness, hoặc nói với chúng tôi vấn đề bạn đang gặp.',
};
---

<Layout metadata={metadata} translationId="contact">
  <HeroText
    tagline="Giới Thiệu"
    title="Liên Hệ OKELAS"
    subtitle="Hầu hết cuộc trò chuyện với chúng tôi bắt đầu bằng một câu hỏi, không phải cam kết."
  />

  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-2xl mx-auto text-center mb-8">
        <p class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed">
          Nếu bạn đã biết khoảng cách nằm ở đâu, cách nhanh nhất để bắt đầu là đánh giá readiness phù hợp — mất khoảng ba phút và cho bạn kết quả hữu ích dù bạn có nói chuyện với chúng tôi hay không. Nếu bạn chưa chắc bắt đầu từ đâu, hãy mô tả vấn đề bạn đang thấy trên xưởng hoặc trong số liệu — đó thường là điểm khởi đầu hữu ích hơn cho cả hai bên.
        </p>
      </div>
      <ContactForm language="vi" />
    </div>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Bắt Đầu Đánh Giá Readiness',
        href: '/readiness',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Hoặc bắt đầu bằng tự đánh giá</Fragment>
    <Fragment slot="subtitle">
      Ba phút. Không cam kết. Kết quả hữu ích dù bước tiếp theo là gì.
    </Fragment>
  </CallToAction>
</Layout>
