---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Liên Hệ OKELAS — Tư Vấn',
  description:
    'Hầu hết cuộc trò chuyện bắt đầu bằng một câu hỏi, không phải cam kết: "Chúng tôi có thực sự sẵn sàng không?" Bắt đầu bằng đánh giá readiness, hoặc nói với chúng tôi vấn đề bạn đang gặp.',
};
---

<Layout metadata={metadata} translationId="contact">
  <HeroText
    tagline="Giới Thiệu"
    title="Liên Hệ OKELAS"
    subtitle="Hầu hết cuộc trò chuyện với chúng tôi bắt đầu bằng một câu hỏi, không phải cam kết: "Chúng tôi có thực sự sẵn sàng không?""
  />

  <ContactUs
    id="form"
    title="Bắt đầu cuộc trò chuyện"
    subtitle="Nếu bạn đã biết khoảng cách nằm ở đâu, cách nhanh nhất để bắt đầu là đánh giá readiness phù hợp — mất khoảng ba phút và cho bạn kết quả hữu ích dù bạn có nói chuyện với chúng tôi hay không. Nếu bạn chưa chắc bắt đầu từ đâu, hãy mô tả vấn đề bạn đang thấy trên xưởng hoặc trong số liệu, không phải giải pháp bạn nghĩ cần — đó thường là điểm khởi đầu hữu ích hơn cho cả hai bên."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Họ và tên',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Doanh nghiệp',
      },
    ]}
    textarea={{
      label: 'Bạn đang gặp vấn đề gì?',
    }}
    disclaimer={{
      label:
        'Bằng cách gửi form này, bạn đồng ý để chúng tôi lưu thông tin liên hệ phục vụ cho yêu cầu này.',
    }}
    description="Chúng tôi thường phản hồi trong vòng một ngày làm việc."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Bắt Đầu Đánh Giá Readiness',
        href: '/readiness',
        icon: 'tabler:clipboard-check',
      },
    ]}
  >
    <Fragment slot="title">Hoặc bắt đầu bằng tự đánh giá</Fragment>
    <Fragment slot="subtitle">
      Ba phút. Không cam kết. Kết quả hữu ích dù bước tiếp theo là gì.
    </Fragment>
  </CallToAction>
</Layout>
