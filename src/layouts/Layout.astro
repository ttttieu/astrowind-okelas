---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  translationId?: string;
}

const { metadata = {}, translationId } = Astro.props;
const { language, textDirection } = I18N;

// Hreflang for translation pairs
let hrefLangLinks: { lang: string; url: string }[] = [];
if (translationId) {
  try {
    const allArticles = await getCollection('insights');
    const pair = allArticles.filter(a => a.data.translationId === translationId && !a.data.draft);
    const hasViEn = pair.some(a => a.data.lang === 'vi') && pair.some(a => a.data.lang === 'en');

    if (pair.length === 2 && hasViEn) {
      const vi = pair.find(a => a.data.lang === 'vi');
      const en = pair.find(a => a.data.lang === 'en');
      if (vi && en) {
        hrefLangLinks = [
          { lang: 'vi', url: `https://www.okelas.com/insights/${vi.data.category}/${vi.id}` },
          { lang: 'en', url: `https://www.okelas.com/en/insights/${en.data.category}/${en.id}` },
          { lang: 'x-default', url: `https://www.okelas.com/insights/${vi.data.category}/${vi.id}` },
        ];
      }
    }
  } catch {}
}
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]" data-translation-id={translationId}>
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Hreflang links for translation pairs -->
    {hrefLangLinks.map(link => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />
  </body>
</html>
