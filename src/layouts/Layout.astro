---
import '~/assets/styles/tailwind.css';

import { Font } from 'astro:assets';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import Intersect from '~/components/common/Intersect.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  translationId?: string;
}

const { metadata = {}, translationId } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]" data-translation-id={translationId}>
  <head>
    <CommonMeta />
    <Favicons />
    <Font cssVariable="--font-inter" preload />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <slot />

    <Intersect />

    <script>
      // Swap dark mode images between light and dark versions based on .dark class
      // Supports multiple article series by matching image prefixes
      function swapDarkModeImages() {
        const isDark = document.documentElement.classList.contains('dark');
        // Match images from multiple article series: anc (nonconformance), aia (internal audit), atrc (training records), asq (supplier qualification), etc.
        const prefixes = ['anc-', 'aia-', 'atrc-', 'asq-'];
        const selector = prefixes.map(p => `img[src*="${p}"]`).join(', ');
        const images = document.querySelectorAll(selector);

        console.log(`[dark-mode-swap] isDark=${isDark}, found ${images.length} images`);

        images.forEach((img) => {
          const originalSrc = img.getAttribute('src');
          if (!originalSrc) return;

          // Check if current src is dark or light version
          const isDarkVersion = originalSrc.includes('-dark.');

          // Build target src by adding or removing -dark suffix
          let targetSrc;
          if (isDark && !isDarkVersion) {
            // Need to add -dark
            targetSrc = originalSrc.replace(/\.(svg|png)$/, '-dark.$1');
          } else if (!isDark && isDarkVersion) {
            // Need to remove -dark
            targetSrc = originalSrc.replace('-dark.', '.');
          } else {
            // Already correct
            return;
          }

          console.log(`[dark-mode-swap] ${originalSrc} → ${targetSrc}`);
          img.setAttribute('src', targetSrc);
        });
      }

      // Run on page load (after DOM is ready)
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', swapDarkModeImages);
      } else {
        swapDarkModeImages();
      }

      // Run on theme changes (after .dark class is toggled)
      document.addEventListener('aw:theme-change', () => {
        console.log('[dark-mode-swap] theme changed, swapping...');
        swapDarkModeImages();
      });
    </script>
  </body>
</html>
